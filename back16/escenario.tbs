// tdp5: escenario de MUGEN convertido con mugen_stage.py y
// hecho vuelta con stage_loop.py (cada capa, su tramo y su espejo).
// Seccion 37 de docs/MODDING.md.
escenario {
    ancho = 2560;
    en_orden;              // el piso tapa el pie de las salpicaduras
    capa lejos {
        pon "00.png" at -174, -238;
        pon "00.png" at 1106, -238 espejo;
    }
    capa media {
        pon "01.png" at -167, -51;
        pon "01.png" at 1113, -51 espejo;
    }
    deriva media -8;
    capa suelo {
        pon "02.png" at -91, -39;
        pon "02.png" at 549, -39;
        pon "02.png" at 1189, -39;
        pon "02.png" at 1829, -39;
    }
    persecucion {
        fondo "03.png" at 0, -203 cielo 200;
    }
}
