// Torneo del Poder: escenario de MUGEN (tdp5).
stage {
    width = 2560;
    in_order;              // el piso tapa el pie de las salpicaduras
    layer far {
        place "00.png" at -174, -238;
        place "00.png" at 1106, -238 mirror;
    }
    layer mid {
        place "01.png" at -167, -51;
        place "01.png" at 1113, -51 mirror;
    }
    drift mid -8;
    layer ground {
        place "02.png" at -91, -39;
        place "02.png" at 549, -39;
        place "02.png" at 1189, -39;
        place "02.png" at 1829, -39;
    }
    chase {
        background "03.png" at 0, -203 sky 200;
    }
}
