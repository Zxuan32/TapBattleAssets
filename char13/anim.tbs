    ano_6 {   // dash
        link ano_106 { flag = 14; }
        frame {
            time = 1; sprite = sprite_3; origin = -37, -106; sound = 16; speed_x = 917504;
            options { effect = 2; }
            hurtbox       at -31, -95  size 64, 96;
            spawn ano_207 at  44, -72;
        }
        frame {
            time = 8; sprite = sprite_3; origin = -37, -106; speed_x = 917504;
