            spawn ano_207 at  44, -72;
        }
        frame {
            time = 4; sprite = sprite_5; origin = -30, -102; speed_x = 524288; accel_x = -39319;
            hurtbox       at -31, -95  size 64, 96;
            spawn ano_207 at  44, -72;
        }
        frame {
            time = 4; sprite = sprite_4; origin = -41, -108; keep_speed; accel_x = -39319;
            options { cancel; }
            hurtbox at -31, -95  size 64, 96;
        }
    }

