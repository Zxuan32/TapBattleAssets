// gla3: escenario de MUGEN convertido con mugen_stage.py y
// hecho vuelta con stage_loop.py (cada capa, su tramo y su espejo).
// Seccion 37 de docs/MODDING.md.
stage {
    width = 1856;
    in_order;              // el piso tapa el pie de las salpicaduras
    layer ground {
        place "00.png" at -268, -77;
        place "00.png" at 660, -77;
    }
    chase {
        background "01.png" at 0, -77 sky 200;
    }
}
