// Time_Chamber_HR: escenario de MUGEN (Time_Chamber_HR.def + Time_Chamber_HR.sff),
// con tools/mugen_stage.py a escala 1.25. Seccion 37 de docs/MODDING.md.
stage {
    width = 1664;
    layer far {
        place "00.png" at -114, -239 repeat;
        place "01.png" at 101, -91 add 50;
        place "01.png" at 517, -91 add 50;
        place "01.png" at 933, -91 add 50;
        place "01.png" at 1349, -91 add 50;
        place "03.png" at 43, 98 add repeat;
    }
    drift far -4;
    layer ground {
        place "02.png" at 42, 142 repeat;
        place "04.png" at 142, 76;
        place "05.png" at 141, 129 add 35;
        place "06.png" at 141, 130;
    }
    chase {
        background "07.png" at 0, -39 sky 200;
    }
}
