package "chart04_1.pac" {
    // Contenido del .pac, EN ORDEN: asi lo lee GameData.Init y el
    // orden es significativo. El numero de 'image' es la hoja que
    // nombra 'sheet' en sprites.tbs, y el de 'sound' la voz que pide
    // 'sound = N' en animation.tbs. Mover una entrada renumera todas
    // las de su tipo, asi que se anade al final ('extract.py adopt').
    //
    // Una voz N se pide desde un frame con 'sound = 80 + N':
    // TcbEngine.PlaySE hace playAudio(no - 80); por debajo de 80
    // es un se_NN.ogg suelto, no una voz del personaje.
    //
    // 'extra' son 4 bytes que el juego NO LEE: GameData.Init saca de
    // cada entrada el offset (pos+0..3), el tamano (pos+4..7) y el
    // tipo (pos+8..11), y a decodeData solo le pasa esos tres; los
    // pos+12..15 no los toca nadie. Tampoco son checksum: hay tres
    // wav de contenido identico con tres 'extra' distintos. Se
    // conservan tal cual solo para que el .pac salga identico; en una
    // entrada nueva se deja sin poner y ya.

    image   "png00.png"   extra = 0xb65188e6;   // hoja 0
    image   "png01.png"   extra = 0x3f7a2830;   // hoja 1
    image   "png02.png"   extra = 0xe2885e9d;   // hoja 2
    image   "png03.png"   extra = 0x8a09a85f;   // hoja 3
    image   "png04.png"   extra = 0x75dfb297;   // hoja 4
    image   "png05.png"   extra = 0x071fbe83;   // hoja 5
    image   "png06.png"   extra = 0xa2fc6d8e;   // hoja 6
    image   "png07.png"   extra = 0x33186a76;   // hoja 7
    image   "png08.png"   extra = 0x6657af9b;   // hoja 8
    image   "png09.png"   extra = 0xd5f1ced0;   // hoja 9
    image   "png10.png"   extra = 0xfb193797;   // hoja 10
    image   "png11.png"   extra = 0x73278eee;   // hoja 11
    image   "png12.png"   extra = 0xc25de217;   // hoja 12
    image   "png13.png"   extra = 0x05f515e1;   // hoja 13
    image   "png14.png"   extra = 0xe218c5fe;   // hoja 14
    image   "png15.png"   extra = 0x8bb3e6f1;   // hoja 15
    tables  "tables.tbs"  extra = 0xe2fa84e2;
    image   "png16.png"   extra = 0xa06e4183;   // hoja 16
    sprites "sprites.tbs" extra = 0xfc0cebbf;
    image   "png17.png"   extra = 0x4400b78c;   // hoja 17
    anim    "anim.tbs"    extra = 0x03e7f4bb;
    sound   "wav00.wav"   extra = 0x64367de3;   // 22050 Hz, 16 bit, mono, 1.98 s
    sound   "wav01.wav"   extra = 0x06beb2f6;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav02.wav"   extra = 0xefd5a219;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav03.wav"   extra = 0x099ed797;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav04.wav"   extra = 0x668361a6;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav05.wav"   extra = 0x8d94cbae;   // 22050 Hz, 16 bit, mono, 0.21 s
    sound   "wav06.wav"   extra = 0x4ae8449f;   // 22050 Hz, 16 bit, mono, 0.57 s
    sound   "wav07.wav"   extra = 0xb9ac8184;   // 22050 Hz, 16 bit, mono, 0.32 s
    sound   "wav08.wav"   extra = 0xd294d533;   // 22050 Hz, 16 bit, mono, 0.65 s
    sound   "wav09.wav"   extra = 0x55f08f7b;   // 22050 Hz, 16 bit, mono, 1.09 s
    sound   "wav10.wav"   extra = 0xc06cfbac;   // 22050 Hz, 16 bit, mono, 2.45 s
    sound   "wav11.wav"   extra = 0xf6ce2a9e;   // 22050 Hz, 16 bit, mono, 1.76 s
    sound   "wav12.wav"   extra = 0x4ebe5fb6;   // 22050 Hz, 16 bit, mono, 2.01 s
    sound   "wav13.wav"   extra = 0x04a40e6d;   // 22050 Hz, 16 bit, mono, 1.22 s
    sound   "wav14.wav"   extra = 0x833a5b1c;   // 22050 Hz, 16 bit, mono, 0.35 s
    mod     "mod.tbs";
    info    "info.tbs";
}
