            time = 3; sprite = sprite_3; origin = -26, -95;
            hurtbox       at -31, -103  size 64, 96;
            spawn ano_207 at  60,  -56;
        }
        frame {
            time = 3; sprite = sprite_3; origin = -26, -95; loop;
            hurtbox       at -31, -103  size 64, 96;
            spawn ano_207 at  60,  -56;
        }
    }

    ano_3 {   // dash
