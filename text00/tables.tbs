tables {
    // Tablas de datos del personaje (GameData.binCnv). Cada 'row_N'
    // es una fila de bytes; el numero es su indice, para poder ir a
    // una fila concreta sin ponerse a contar.
    //
    // 'columns' y 'rows' son lo que declara la cabecera del binario;
    // 'real' son las filas que de verdad ocupa el bloque, que suelen
    // ser mas: el motor indexa sin mirar el alto declarado y guarda
    // datos ahi (la ultimate esta en la fila 22 de la tabla 4 aunque
    // esa declare 19, y los efectos de cinematica en la 44 de la 13).
    //
    // 'gap' y 'tail' son bytes entre tablas que la cabecera no
    // describe; se conservan tal cual.
    //
    // Al compilar se recalculan las posiciones, asi que cambiar el
    // tamano de una tabla puede dejar mal las celdas que sean
    // punteros a otra.

    table_0 {
        // cada COLUMNA es una CPUSeq, asignada segun el nivel de CPU;
        // al final, los datos del CPURand
        columns = 1;
        rows    = 315;   // lo que declara la cabecera
        real    = 27507;   // las que de verdad hay (tamano / columns)
        text_0   = "¿Volver a la pantalla de título?";
        text_1   = "　　　　　  ¿Salir de la aplicación?";
        text_2   = "No";
        text_3   = " _ _¡Haz crecer a tu personaje peleando contra la CPU! _¡Al ganar, obtienes su carta de habilidad!";
        text_4   = " _ _Pelea en tiempo real con otra persona _que tenga la aplicación, por red local. _Conecten los dos equipos a la misma red.";
        text_5   = " _　Pelea sin parar contra un rival tras otro. _　Un solo round y la vida no se recupera. _　¿Hasta dónde puedes llegar?";
        text_6   = " _　Pelea en equipos de 3 personajes. _　Cuando uno cae, entra el siguiente. _　Si caen los tres, se acaba la partida.";
        text_7   = " _ _　　 Entrena con la configuración que quieras.";
        text_8   = " _ _　  Consulta cómo jugar y ajusta las opciones.";
        text_9   = "La EXP depende de cómo juegues. _¡Gana rápido y con la mayor vida posible! _A mayor dificultad, más EXP.";
        text_10  = "¿Conectar por Bluetooth?";
        text_11  = "Sí";
        text_12  = "No";
        text_13  = "No se pudo conectar.";
        text_14  = "¿Pelear otra vez?";
        text_15  = "Elige tu personaje.";
        text_16  = "Costo excedido, no se puede elegir.";
        text_17  = "La versión de la aplicación no coincide. _Actualiza a la última versión.";
        text_18  = "　　　　　　　   Se perdió la conexión";
        text_19  = "　　   Esperando a que el rival elija personaje.";
        text_20  = "¡¡Encontraste una esfera del dragón!!";
        text_21  = "¡Obtuviste la esfera de 1 estrella!";
        text_22  = "¡Obtuviste la esfera de 2 estrellas!";
        text_23  = "¡Obtuviste la esfera de 3 estrellas!";
        text_24  = "¡Obtuviste la esfera de 4 estrellas!";
        text_25  = "¡Obtuviste la esfera de 5 estrellas!";
        text_26  = "¡Obtuviste la esfera de 6 estrellas!";
        text_27  = "¡Obtuviste la esfera de 7 estrellas!";
        text_28  = "Las esferas del dragón empiezan a brillar...";
        text_29  = "Obtuviste la carta de habilidad [Shenlong].";
        text_30  = "";
        text_31  = "La carta ya tiene el rango máximo: obtuviste un boleto.";
        text_32  = "";
        text_33  = " _¡Obtenida!";
        text_34  = "¡¡Obtuviste un boleto!!";
        text_35  = "Ya no se pueden hacer más canjes.";
        text_36  = "No tienes suficientes boletos";
        text_37  = "";
        text_38  = "　Enviar carta de habilidad";
        text_39  = "Recibir carta de habilidad";
        text_40  = " _¡Obtenida!";
        text_41  = "";
        text_42  = " _¡La carta sube a rango +1!";
        text_43  = " _¡La carta sube a rango +2!";
        text_44  = " _¡La carta sube a rango +3!";
        text_45  = " _¡La carta sube a rango +4!";
        text_46  = " _¡La carta sube a rango +5!";
        text_47  = " _¡La carta sube a rango +6!";
        text_48  = " _¡La carta sube a rango +7!";
        text_49  = " _¡La carta sube a rango +8!";
        text_50  = " _¡La carta sube a rango +9!";
        text_51  = " _¡La carta sube a rango +10!";
        text_52  = "";
        text_53  = "　　　　   Esperando a que el rival envíe...";
        text_54  = "　　　　    ¿Enviar la carta?";
        text_55  = "　　　　　　　   Carta recibida";
        text_56  = "　　　　　Error: la carta ya tiene rango MAX";
        text_57  = "　　　　　　　 Esperando al rival...";
        text_58  = "　　　   Esperando a que el rival esté listo...";
        text_59  = "　　　　　　　   Carta enviada";
        text_60  = "Así que tú reuniste las esferas del dragón...";
        text_61  = "Ya sé cuál es tu deseo.";
        text_62  = "Me convertiré en carta de habilidad y te daré mi poder.";
        text_63  = "Mira los personajes que has conseguido";
        text_64  = "Mira las cartas de habilidad que has conseguido";
        text_65  = "Mira las esferas del dragón que has conseguido";
        text_66  = "Intercambia cartas de habilidad con otra persona";
        text_67  = "Canjea tus boletos por cartas de habilidad";
        text_68  = "　　　　　　　　  ¿Hacer el canje?";
        text_69  = "　　　　　 No tienes suficientes boletos";
        text_70  = "La carta ya tiene el rango máximo. No hay más canjes";
        text_71  = " _ _Siete misiones nuevas cada día. _Cada una que cumplas te da puntos para la [SHOP].";
        text_72  = "¿Volver al menú principal?";
        text_73  = "Estas son tus esferas del dragón. _Toca una para ver cómo se consigue.";
        text_74  = "";
        text_75  = "　Equipa la carta de habilidad [Shenlong].";
        text_76  = "　　　　  Equipa 2 o más cartas de habilidad.";
        text_77  = "Aquí termina la práctica.";
        text_78  = "Misión 1 _　¡¡Lanza un Kamehameha!!";
        text_79  = "Misión 2 _　　　　Gana un Rush Fight";
        text_80  = "Misión 3 _　 Gana una batalla de cartas";
        text_81  = "Misión 4 _　　　 Vence a Krilin";
        text_82  = "Misión 5 _　　    Vence a Piccolo";
        text_83  = "Misión 6 _　　    Vence a Freezer";
        text_84  = "Misión 7 _　　 Vence a Gohan";
        text_85  = "Goku, diviérteme un rato";
        text_86  = "";
        text_87  = "¡Mantén tocado [攻] para cargar ki!";
        text_88  = "¡Mantén tocado a tu personaje para cargar ki!";
        text_89  = "¡Kamehameha con [超]!";
        text_90  = "¡Ataca a Krilin para un Rush Fight!";
        text_91  = "¡Ataca a Krilin para una batalla de cartas!";
        text_92  = "¡Vence a Krilin!";
        text_93  = "Vence a Gohan";
        text_94  = "¡Vence a Piccolo!";
        text_95  = "¡Vence a Freezer!";
        text_96  = "¡Vence a Gohan!";
        text_97  = "¡Toca tu retrato para el [estallido de furia]!";
        text_98  = "¡Llena 2 barras de ki!";
        text_99  = "¡Toca tu retrato para lanzar la [ultimate]!";
        text_100 = "Vaya, bienvenido. _¿Vienes a entrenar tus chistes? _ _...¿No?";
        text_101 = "¿Quieres pelear para hacerte más fuerte?";
        text_102 = "...Entonces pon a prueba tu fuerza con las misiones _y reúne las #c4esferas del dragón#c0.";
        text_103 = "Cuando juntes las 7 esferas del dragón _tu deseo se cumplirá.";
        text_104 = "Después te espera un rival temible... _Pelear contra él será mi prueba para ti.";
        text_105 = "La primera misión es aprender los ataques básicos.";
        text_106 = "Durante la misión hay instrucciones: síguelas.";
        text_107 = "¡Buena suerte!";
        text_108 = "";
        text_109 = "";
        text_110 = "¡Vaya, vaya...! _¡Llegó alguien que promete...!";
        text_111 = "La siguiente misión es ganar un #c4Rush Fight#c0.";
        text_112 = "En el Rush Fight gana quien toque más veces _los botones que van apareciendo.";
        text_113 = "A veces sale un #c4botón de otro color#c0; _tocarlo te da ventaja, ¡no lo dejes pasar!";
        text_114 = "El Rush Fight empieza cuando los ataques _de los dos chocan.";
        text_115 = "¡Acércate y ataca! _Krilin se va a sincronizar contigo.";
        text_116 = "Bien, allá vamos.";
        text_117 = "";
        text_118 = "";
        text_119 = "";
        text_120 = "Vaya... _Qué fácil te resultó...";
        text_121 = "La siguiente misión es ganar _una #c4batalla de cartas#c0.";
        text_122 = "En la batalla de cartas gana quien tenga el _personaje y las #c4cartas de habilidad#c0 _equipadas más fuertes.";
        text_123 = "El Rush Fight y la batalla de cartas _salen por turnos, en las mismas condiciones.";
        text_124 = "Ah, para la batalla de cartas _necesitas cartas de habilidad. _Te preparé unas; equípalas ahora mismo.";
        text_125 = "Esta vez toca [Automático] y no fallarás. _Cuando te acostumbres, prueba otras.";
        text_126 = "Bien, allá vamos.";
        text_127 = "";
        text_128 = "";
        text_129 = "";
        text_130 = "¡Excelente!";
        text_131 = "La siguiente misión: ¡aprender la #c4ultimate#c0!";
        text_132 = "Primero hay que llenar la #c4barra de furia#c0, _que sube cuando recibes daño.";
        text_133 = "Con la furia al MAX puedes hacer el #c4estallido de furia#c0, _¡y solo durante el estallido sale la #c4ultimate#c0!";
        text_134 = "Es un poco difícil, _pero tú quizá lo logres dominar.";
        text_135 = "Sigue las instrucciones de la misión _¡y aprende la ultimate!";
        text_136 = "";
        text_137 = "";
        text_138 = "";
        text_139 = "";
        text_140 = "Eres tan bueno como pensaba. _Ya la dominas, y tan rápido...";
        text_141 = "El estallido de furia es poderoso, _ #c4pero dura poco: ten cuidado#c0.";
        text_142 = "La ultimate es más fácil si cargas el ki _antes del estallido de furia. _No lo olvides.";
        text_143 = "¡La siguiente misión por fin es un combate real!";
        text_144 = "#c4Ahora corre el tiempo y los golpes quitan vida#c0";
        text_145 = "Tu rival es Piccolo. _Es duro, ¡pero puedes ganarle!";
        text_146 = "Adelante.";
        text_147 = "";
        text_148 = "";
        text_149 = "";
        text_150 = "Nada mal... _No sabía que había alguien así allá abajo...";
        text_151 = "Por cierto, ¿notaste los tipos de las cartas?";
        text_152 = "Hay 3 tipos: [Bueno], [Malo] y [Neutral], _y van con el tipo del personaje.";
        text_153 = "Goku es [Bueno], Piccolo [Neutral] y Freezer [Malo].";
        text_154 = "Si la carta y el personaje son del mismo tipo, _ #c4suben un poco el ataque y la defensa#c0.";
        text_155 = "Por lo general conviene equipar cartas del mismo tipo.";
        text_156 = "Pero ciertas combinaciones de tipos distintos _pueden dar un poder increíble.";
        text_157 = "Bueno, me desvié del tema. _Tu próximo rival es Freezer.";
        text_158 = "Adelante.";
        text_159 = "";
        text_160 = "Vaya, vaya... _Tu fuerza no tiene límite...";
        text_161 = "Bien, se acerca la batalla decisiva.";
        text_162 = "Si superas la próxima misión reunirás las esferas _y tu deseo se cumplirá.";
        text_163 = "Tu rival es Gohan. _No te dejes vencer.";
        text_164 = "Adelante.";
        text_165 = "";
        text_166 = "";
        text_167 = "";
        text_168 = "";
        text_169 = "";
        text_170 = "¡Excelente! _La verdad no creí que juntaras _las esferas del dragón tan rápido.";
        text_171 = "Equipa la carta #c4Shenlong#c0 que obtuviste _y enfrenta a Cell.";
        text_172 = "Pero ojo: _equiparla no te asegura la victoria. _Así de temible es su fuerza.";
        text_173 = "¿Entendido? _No te descuides ni un segundo.";
        text_174 = "¡¡Ahora ve!!";
        text_175 = "";
        text_176 = "";
        text_177 = "";
        text_178 = "";
        text_179 = "";
        text_180 = "Parece que terminaste todas las misiones. _Buen trabajo, buen trabajo.";
        text_181 = "Las cartas de habilidad se refuerzan _al conseguir otra igual.";
        text_182 = "¡Tú vence a muchos rivales! _Así subirás de nivel _y conseguirás cartas de habilidad.";
        text_183 = "¡Si cumples ciertas condiciones _podrás reunir las esferas otra vez!";
        text_184 = "Aquí termina mi prueba. _Ahora juega como quieras.";
        text_185 = "¡Nos vemos!";
        text_186 = "";
        text_187 = "";
        text_188 = "";
        text_189 = "";
        text_190 = "Obtuviste la carta de habilidad [Shenlong]. _¡La carta sube a rango +1!";
        text_191 = "Obtuviste la carta de habilidad [Shenlong]. _¡La carta sube a rango +2!";
        text_192 = "Obtuviste la carta de habilidad [Shenlong]. _¡La carta sube a rango +3!";
        text_193 = "Obtuviste la carta de habilidad [Shenlong]. _¡La carta sube a rango +4!";
        text_194 = "Obtuviste la carta de habilidad [Shenlong]. _¡La carta sube a rango +5!";
        text_195 = "Obtuviste la carta de habilidad [Shenlong]. _¡La carta sube a rango +6!";
        text_196 = "Obtuviste la carta de habilidad [Shenlong]. _¡La carta sube a rango +7!";
        text_197 = "Obtuviste la carta de habilidad [Shenlong]. _¡La carta sube a rango +8!";
        text_198 = "Obtuviste la carta de habilidad [Shenlong]. _¡La carta sube a rango +9!";
        text_199 = "Obtuviste la carta de habilidad [Shenlong]. _¡La carta sube a rango +10!";
        text_200 = "#c4◆Modos 1#c0 _ _[Arcade] _　Combates seguidos contra la CPU, con _　personajes repetidos incluidos. _　En [Fácil] aparecen 7 personajes. _　En [Normal] y [Difícil] aparecen todos, _　incluidos los adicionales. _ _[Versus] _　Pelea contra otra persona por red local. _　Solo entre copias del mismo juego. _　Más detalles en la página siguiente. _";
        text_201 = "#c4◆Modos 2#c0 _ _[Versus por red local] _　Conecten los dos equipos a la misma red _　Wi-Fi. _　La conexión puede fallar si: _ _　① La red bloquea equipos entre sí _　② La señal es débil _ _　Si no logras conectar, apaga y vuelve a _　encender el Wi-Fi e inténtalo otra vez. _ _";
        text_202 = "#c4◆Modos 3#c0 _ _[Ranking] _　Guarda las puntuaciones de [Arcade]. _ _[Cartas y esferas] _　Mira tus cartas y esferas del dragón, _　intercambia cartas y canjea boletos. _ _[Entrenamiento] _　Práctica con la CPU configurable. _ _[Opciones] _　Cómo jugar y configuración. _";
        text_203 = "#c4◆Personajes 1#c0 _ _[Crecimiento] _　Al superar el [Arcade] el personaje _　recibe experiencia. _　Con suficiente experiencia sube de nivel, _　y así mejoran su ataque, su defensa _　y más. _ _ _ _ _ _ _";
        text_204 = "#c4◆Personajes 2#c0 _ _[Comprar personajes] _　En [SHOP] puedes comprar personajes extra. _ _ _ _ _ _ _ _ _ _ _";
        text_205 = "#c4◆Cartas de habilidad 1#c0 _ _　Equipa [cartas de habilidad] a tu personaje _　para subir su ataque y su defensa. _ _[Costo] _　Cada carta tiene un [costo]. Puedes equipar _　hasta 8 cartas mientras la suma no pase _　del [costo de equipo] del personaje. _ _　Cada personaje tiene su [costo de equipo], _　que sube al subir de nivel. _ _";
        text_206 = "#c4◆Cartas de habilidad 2#c0 _ _[Cómo obtenerlas: superar el Arcade] _　Al superar el [Arcade] obtienes la carta _　propia del personaje. _ _[Cómo obtenerlas: esferas del dragón] _　Cada vez que juntas las 7 esferas _　obtienes la carta [Shenlong].";
        text_207 = "#c4◆Cartas de habilidad 3#c0 _ _[Cómo obtenerlas: canje de boletos] _　Canjea por cartas los [boletos] que _　ganas en las batallas. _ _[Mejorar cartas] _　Al conseguir una carta repetida se _　[fusiona] y mejora de +1 hasta +10. _　Desde la carta 11, cada repetida se _　convierte en [boleto]. _ _ _ _";
        text_208 = "#c4◆Cartas de habilidad 4#c0 _ _[Tipo] _　Las cartas son de tipo [Bueno], [Malo] o _　[Neutral]. Si una carta equipada es del _　mismo tipo que el personaje, sube un poco _　el ataque y la defensa. _ _[Rareza] _　Hay 3 rarezas; de menos a más poder: _　[NORMAL], [RARE] y [SHENRON]. _ _ _";
        text_209 = "#c4◆Esferas del dragón#c0 _ _　Si cumples ciertas condiciones al _　superar el [Arcade], obtienes una esfera. _　Junta las 7 esferas y obtendrás la _　poderosa carta [Shenlong]. _ _ _ _ _ _ _ _ _";
        text_210 = "#c4◆Formaciones#c0 _ _Según las cartas que equipe el personaje se _activa una [formación]. _※Puede activar habilidades especiales. _ _[Formación de tipo] _　Se activa al equipar cierta cantidad _　de cartas del mismo tipo. _ _[Formación específica] _　Se activa al equipar cartas concretas. _ _ _";
        text_211 = "#c4◆Boletos#c0 _ _[Boletos] _　Ganas un [boleto] cada vez que vences _　a un personaje en el [Arcade]. _　Si consigues otra vez una carta +10, _　se convierte sola en boleto. _ _[Canje por cartas] _　En [Cartas y esferas] → [Canje de boletos] _　cambias boletos por cartas de habilidad. _ _ _ _";
        text_212 = "#c4◆Dos formas de control#c0 _ _El juego tiene 2 formas de control. _ _[Tap Battle] _　Toca a dónde moverte o a qué enemigo _　atacar para controlar al personaje. _ _[Stick virtual] _　Controla con la cruceta y los botones. _ _Se cambia en [Opciones] → [Configuración]. _ _";
        text_213 = "#c4◆Controles: Tap Battle 1#c0 _ _[Moverse] _　Toca un lugar vacío para ir hasta ahí. _　Toca el aire o a tu personaje para _　saltar. _ _[Cargar ki] _　Mantén tocado a tu personaje para _　llenar la barra de ki. _ _ _ _";
        text_214 = "#c4◆Controles: Tap Battle 2#c0 _ _[Teletransporte] _　Toca dos veces un lugar vacío para _　teletransportarte ahí. _　En el aire quedas [volando] y puedes _　moverte en todas direcciones. _　Al tocar el suelo vuelves a la normalidad. _ _[Evitar caída] _　Toca a tu personaje mientras sale volando _　para recuperarte rápido. _ _";
        text_215 = "#c4◆Controles: Tap Battle 3#c0 _ _[Ataque] _　Según la distancia, sobre el enemigo sale _　[攻], [突撃] o [気弾]. _　Toca al enemigo para atacar según la _　distancia. _ _　[Guardia] _　Cuando puedes cubrirte, lo haces solo. _ _　[Pausa] _　Toca el reloj para abrir el menú de pausa. _ _";
        text_216 = "#c4◆Controles: Tap Battle 4#c0 _ _[Súper especial] _　Toca al enemigo cuando muestre [超必殺]. _　A veces cancela otros ataques. _　Gasta 1 barra de ki. _ _　[Contraataque] _　Toca a tu personaje mientras te cubres _　de un ataque para contraatacar. _　Gasta 1 barra de ki. _ _";
        text_217 = "#c4◆Controles: Tap Battle 5#c0 _ _[Barra de furia] _　Es la que rodea tu retrato. _　Sube al recibir daño. _ _[Estallido de furia] _　Con la furia al MAX, toca tu retrato para _　entrar en [estallido de furia] y subir _　el ataque. Durante el estallido puedes _　lanzar la [ultimate]. _ _ _ _";
        text_218 = "#c4◆Controles: Tap Battle 6#c0 _ _[Ultimate] _　Durante el estallido de furia, toca tu _　retrato para lanzar la [ultimate]. _　Gasta 2 barras de ki. _ _[Persecución] _　Tras un Rush Fight, los golpes extra _　dependen del ataque. _ _ _ _";
        text_219 = "#c4◆Controles: Stick virtual 1#c0 _ _[Moverse 1] _　Muévete con la cruceta de la izquierda. _　※Comandos mirando a la derecha _ _　Atrás/Adelante: ←/→ _　Saltar: ↑ _　Dash adelante: →→ _　Paso atrás: ←← _　Dash arriba/abajo: ↑↑/↓↓ _ _ _";
        text_220 = "#c4◆Controles: Stick virtual 2#c0 _ _[Moverse 2] _　Dash rápido adelante: →→→ _　Dash rápido atrás: ←←← _　Teletransporte (al frente): ←→←+[攻] _　Teletransporte (por detrás): →←→+[攻] _ _[Guardia] _　← mientras el rival ataca _ _[Evitar caída] _　[攻] mientras sales volando para _　recuperarte rápido.";
        text_221 = "#c4◆Controles: Stick virtual 3#c0 _ _[Vuelo] _　Empiezas a [volar] con: _   ・Dash arriba en el suelo _　　・↑ durante un salto _　Mientras vuelas puedes moverte por el aire. _ _[Pausa] _　Toca el reloj para abrir el menú de pausa. _ _ _ _";
        text_222 = "#c4◆Controles: Stick virtual 4#c0 _ _[Ataque] _　Ataque débil: [攻] _　Ataque fuerte A: →+[攻] _　Ataque fuerte B: ←+[攻] _　Ataque fuerte C: ↓+[攻] _　Ataque en dash: [攻] durante el dash _ _ _ _ _ _";
        text_223 = "#c4◆Controles: Stick virtual 5#c0 _ _[Especiales] _　Especial 1: [必] izquierdo _　   ※En suelo o volando, [攻] sigue el ataque _　Especial 2: [必] del centro _　Especial 3: [必] derecho _ _[Cargar ki] _　Mantén tocado [攻] para llenar la _　barra de ki. _ _ _";
        text_224 = "#c4◆Controles: Stick virtual 6#c0 _ _[Súper especial] _　Con 1 barra de ki o más aparece [超]; _　tócalo para lanzarlo. _　Gasta 1 barra de ki. _ _[Contraataque] _　Toca [攻] mientras te cubres de un ataque _　para contraatacar. _　Gasta 1 barra de ki. _ _ _";
        text_225 = "#c4◆Controles: Stick virtual 7#c0 _ _[Barra de furia] _　Es la que rodea tu retrato. _　Sube al recibir daño. _ _[Estallido de furia] _　Con la furia al MAX, toca tu retrato para _　entrar en [estallido de furia] y subir _　el ataque. Durante el estallido puedes _　lanzar la [ultimate]. _ _ _ _";
        text_226 = "#c4◆Controles: Stick virtual 8#c0 _ _[Ultimate] _　Durante el estallido de furia, toca tu _　retrato para lanzar la [ultimate]. _　Gasta 2 barras de ki. _ _[Persecución] _　Tras un Rush Fight, los golpes extra _　dependen del ataque. _ _ _ _";
        text_227 = "#c4◆Momentos especiales 1#c0 _ _[Rush Fight] _　Cuando tu ataque choca con el del rival _　empieza un [Rush Fight]. _　Gana quien toque más botones de los que _　aparecen antes de que acabe el tiempo. _　A veces sale un botón de otro color que _　vale más de lo normal. _ _ _ _ _";
        text_228 = "#c4◆Momentos especiales 2#c0 _ _[Choque de súper especiales] _　Cuando alguien lanza un súper especial, el _　rival puede responder con otro. ¡Toca _　sin parar para ganar el choque! _ _ _ _ _ _ _";
        text_229 = "#c4◆Momentos especiales 3#c0 _ _[Batalla de cartas] _　Sale por turnos con el Rush Fight, en las _　mismas condiciones. _　Se compara el poder de cada uno (ataque _　+ defensa) más el de sus cartas; gana el _　que suma más. _ _ _ _ _";
        text_230 = "◆En preparación... _ _ _ _ _ _ _ _ _ _ _ _ _";
