stage {
    width = 1376;

    layer far {
        place "00.png" at 0, -70 sky 300 below 200;
        place "02.png" at 688, -70 sky 300 below 200;
    }

    layer ground {
        place "01.png" at 0, 59 below 60;
        place "01.png" at 688, 59 mirror below 60;
    }

    chase {
        background "03.png" at 0, -70 sky 300 below 200;
    }
}
