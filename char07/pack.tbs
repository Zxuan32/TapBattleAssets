package "char07.pac" {
    // Contenido del .pac, EN ORDEN: asi lo lee GameData.Init y el
    // orden es significativo. El numero de 'image' es la hoja que
    // nombra 'sheet' en sprites.tbs, y el de 'sound' la voz que pide
    // 'sound = N' en animation.tbs. Mover una entrada renumera todas
    // las de su tipo, asi que se anade al final ('extract.py adopt').
    //
    // Una voz N se pide desde un frame con 'sound = 80 + N':
    // TCBManajer1 /*00DC1*/ hace playAudio(no - 80); por debajo de 80
    // /*00DBD*/ es un se_NN.ogg suelto, no una voz del personaje.
    //
    // 'extra' son 4 bytes que el juego NO LEE: GameData.Init saca de
    // cada entrada el offset (pos+0..3), el tamano (pos+4..7) y el
    // tipo (pos+8..11), y a decodeData solo le pasa esos tres; los
    // pos+12..15 no los toca nadie. Tampoco son checksum: hay tres
    // wav de contenido identico con tres 'extra' distintos. Se
    // conservan tal cual solo para que el .pac salga identico; en una
    // entrada nueva se deja sin poner y ya.

    image   "png00.png"   extra = 0x09f92600;   // hoja 0
    image   "png01.png"   extra = 0x78da5c00;   // hoja 1
    image   "png02.png"   extra = 0x8f4cac00;   // hoja 2
    image   "png03.png"   extra = 0x7eea8f00;   // hoja 3
    image   "png04.png"   extra = 0x364f9300;   // hoja 4
    image   "png05.png"   extra = 0x26478f00;   // hoja 5
    image   "png06.png"   extra = 0xcbfed200;   // hoja 6
    image   "png07.png"   extra = 0x6e1e6800;   // hoja 7
    image   "png08.png"   extra = 0x3ad3a300;   // hoja 8
    image   "png09.png"   extra = 0xc52f5300;   // hoja 9
    image   "png10.png"   extra = 0x2f338300;   // hoja 10
    image   "png11.png"   extra = 0xd3d62f00;   // hoja 11
    image   "png12.png"   extra = 0x41580b00;   // hoja 12
    image   "png13.png"   extra = 0x097a3a00;   // hoja 13
    image   "png14.png"   extra = 0x1ec72f00;   // hoja 14
    image   "png15.png"   extra = 0xecc68200;   // hoja 15
    tables  "tables.tbs"  extra = 0xecb8e900;
    sprites "sprites.tbs" extra = 0xa8d38600;
    anim    "anim.tbs"    extra = 0xd68ddd00;
    sound   "wav00.wav"   extra = 0x6bbf8b00;   // 22050 Hz, 16 bit, mono, 0.98 s
    sound   "wav01.wav"   extra = 0x75023a00;   // 22050 Hz, 16 bit, mono, 0.64 s
    sound   "wav02.wav"   extra = 0xaca8cc00;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav03.wav"   extra = 0x5f1d7e00;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav04.wav"   extra = 0xab05e900;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav05.wav"   extra = 0x4e638200;   // 22050 Hz, 16 bit, mono, 0.41 s
    sound   "wav06.wav"   extra = 0x8a324900;   // 22050 Hz, 16 bit, mono, 0.49 s
    sound   "wav07.wav"   extra = 0x676e2400;   // 22050 Hz, 16 bit, mono, 0.36 s
    sound   "wav08.wav"   extra = 0xe0794300;   // 22050 Hz, 16 bit, mono, 0.43 s
    sound   "wav09.wav"   extra = 0xa1e37b00;   // 22050 Hz, 16 bit, mono, 0.58 s
    sound   "wav10.wav"   extra = 0x152a4300;   // 22050 Hz, 16 bit, mono, 1.87 s
    sound   "wav11.wav"   extra = 0x11665a00;   // 22050 Hz, 16 bit, mono, 1.82 s
    sound   "wav12.wav"   extra = 0x20724e00;   // 22050 Hz, 16 bit, mono, 2.15 s
    sound   "wav13.wav"   extra = 0xcc3a7400;   // 22050 Hz, 16 bit, mono, 1.34 s
    sound   "wav14.wav"   extra = 0x54a06e00;   // 22050 Hz, 16 bit, mono, 1.69 s
    info    "info.tbs";
}
