    table_3 {
        // stats base (18 bytes):
        //   0 Y,X ispeed move (val<<16)   9 defensa de carta
        //   1 X move (val<<16)           11 iHP
        //   3 iXSize/iLeft/iRight        12 iattack (val*10)
        //   4 limite Y del jugador       13 idefence (val*10)
        //   5 iXSize/x move              16 ANO por defecto
        //   6 tipo de aire               17 coste
        //   8 isynchro (val*100)
        columns = 18;
        rows    = 1;   // lo que declara la cabecera
        row_0 =   5,   5,  25,  56,  64,  80,   1,  10,   1,   2,   2, 100, 100,   0,   0,  48, 211,  12;
    }

    table_4 {
        // registro de ataque. Un registro son DOS filas (48 bytes) y se
        // indexa por SpecialType*2: la fila 22 es la ultimate de suelo y la
        // 24 la de aire. Columnas del registro, en u16 LE:
        //   0 SpecialKind/flag de ano1   13 flag de switch
        //   1 ano1 (la animacion)        14 angulo
        //   2-3 BulletAction[0..1]       15 max. de balas
        //   4 ano                        16 iActNoBHit (ano)
        //   5-8 iActNo1/2 tipos 1 y 2    17-18 BulletAction[0]
        //   9-10 twork 4/5, de la bala   19-21 twork 12/13 (anos)
