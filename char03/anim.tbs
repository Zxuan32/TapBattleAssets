            spawn ano_207 at  64, -72;
        }
        frame {
            time = 4; sprite = sprite_0; origin = -34, -118; keep_speed; accel_x = -39319;
            options { cancel; }
            hurtbox at -31, -95  size 64, 96;
        }
    }

