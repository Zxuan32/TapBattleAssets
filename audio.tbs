    sfx_9  { file = "loose/se_09.ogg"; }   // 44100 Hz, mono, 0.7 s, 14853 bytes
    sfx_10 { file = "loose/se_10.ogg"; }   // 44100 Hz, mono, 3.5 s, 60275 bytes
    sfx_11 { file = "loose/se_11.ogg"; }   // 44100 Hz, mono, 0.9 s, 19220 bytes
    sfx_12 { file = "loose/se_12.ogg"; }   // 44100 Hz, mono, 0.5 s, 12065 bytes
    sfx_13 { file = "loose/se_13.ogg"; }   // 44100 Hz, mono, 1.0 s, 20239 bytes
    sfx_14 { file = "loose/se_14.ogg"; }   // 44100 Hz, mono, 2.2 s, 39491 bytes
    sfx_15 { file = "loose/se_15.ogg"; }   // 44100 Hz, mono, 0.8 s, 16604 bytes
    sfx_16 { file = "loose/se_16.ogg"; }   // 44100 Hz, mono, 0.1 s, 5023 bytes
    sfx_17 { file = "loose/se_17.ogg"; }   // 44100 Hz, mono, 0.2 s, 7618 bytes
    sfx_18 { file = "loose/se_18.ogg"; }   // 44100 Hz, mono, 0.2 s, 4820 bytes

    // musica
    music_0  { file = "bgm/bgm_00.ogg"; }   // 44100 Hz, estereo, 12.1 s, 201590 bytes
    music_1  { file = "bgm/bgm_01.ogg"; }   // 44100 Hz, estereo, 10.4 s, 174022 bytes
    music_2  { file = "bgm/bgm_02.ogg"; }   // 44100 Hz, estereo, 13.0 s, 215205 bytes
    music_3  { file = "bgm/bgm_03.ogg"; }   // 44100 Hz, estereo, 30.9 s, 507156 bytes
    music_4  { file = "bgm/bgm_04.ogg"; }   // 44100 Hz, estereo, 26.9 s, 440550 bytes
    music_5  { file = "bgm/bgm_05.ogg"; }   // 44100 Hz, estereo, 25.8 s, 423274 bytes
    music_6  { file = "bgm/bgm_06.ogg"; }   // 44100 Hz, estereo, 26.3 s, 431952 bytes
    music_7  { file = "bgm/bgm_07.ogg"; }   // 44100 Hz, estereo, 29.1 s, 477037 bytes
