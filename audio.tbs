audio {
    // La musica y los efectos NO salen de ningun .pac: son ficheros
    // sueltos que el motor abre por nombre (Utility.SoundName), asi
    // que anadir una pista es dejar el .ogg con su numero.
    // Cada bgm_NN.ogg puede llevar un bgm_NN.png: es su rotulo en el
    // selector de OST, y el ano 100+NN del chardemo99 lo dibuja.
    // Las rutas son relativas a esta carpeta; al construir, cada uno
    // va a los assets con su nombre a secas.

    // efectos de sonido
    sfx_0  { file = "loose/se_00.ogg"; }   // 44100 Hz, mono, 0.9 s, 18037 bytes
    sfx_1  { file = "loose/se_01.ogg"; }   // 44100 Hz, mono, 0.5 s, 11979 bytes
    sfx_2  { file = "loose/se_02.ogg"; }   // 44100 Hz, mono, 0.3 s, 8677 bytes
    sfx_3  { file = "loose/se_03.ogg"; }   // 44100 Hz, mono, 0.4 s, 10028 bytes
    sfx_4  { file = "loose/se_04.ogg"; }   // 44100 Hz, mono, 0.7 s, 14966 bytes
    sfx_5  { file = "loose/se_05.ogg"; }   // 44100 Hz, mono, 1.3 s, 25135 bytes
    sfx_6  { file = "loose/se_06.ogg"; }   // 44100 Hz, mono, 1.4 s, 27148 bytes
    sfx_7  { file = "loose/se_07.ogg"; }   // 44100 Hz, mono, 2.4 s, 42602 bytes
