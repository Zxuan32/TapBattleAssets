// jan2: escenario de MUGEN convertido con mugen_stage.py y
// hecho vuelta con stage_loop.py (cada capa, su tramo y su espejo).
// Seccion 37 de docs/MODDING.md.
escenario {
    ancho = 1920;
    en_orden;              // el piso tapa el pie de las salpicaduras
    capa lejos {
        pon "00.png" at -400, -614;
    }
    capa media {
        pon "01.png" at -400, -645;
    }
    capa suelo {
        pon "02.png" at -400, 6;
    }
    persecucion {
        fondo "03.png" at 0, -711 cielo 200;
    }
}
