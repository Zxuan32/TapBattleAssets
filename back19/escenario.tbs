// jan2: escenario de MUGEN convertido con mugen_stage.py y
// hecho vuelta con stage_loop.py (cada capa, su tramo y su espejo).
// Seccion 37 de docs/MODDING.md.
stage {
    width = 1920;
    in_order;              // el piso tapa el pie de las salpicaduras
    layer far {
        place "00.png" at -400, -614;
    }
    layer mid {
        place "01.png" at -400, -645;
    }
    layer ground {
        place "02.png" at -400, 6;
    }
    chase {
        background "03.png" at 0, -711 sky 200;
    }
}
