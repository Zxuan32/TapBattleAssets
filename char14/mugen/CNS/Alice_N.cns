hitflag = MAF                    ;能击中什么状态的敌人
priority = 4, Hit                ;攻击优先度: 0 (最低) to 7 (最高), 4 默认，相杀式的处理：Hit-可以击中非dodge情况的敌方/Miss-我方攻击一定miss/Dodge-一定躲避敌方攻击 (默认: Hit)
pausetime = 8, 0                 ;攻击者暂停的时间, 对手在hitshake的时间
