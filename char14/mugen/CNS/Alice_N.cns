;---------------------------------------------------------------------------
; 轻攻击
[Statedef 200]
type    = S                      ;状态: S-站立, C-蹲, A-空中, L-倒地
movetype= A                      ;招式种类: A-攻击, I-非攻击, H-受击
physics = S                      ;物理: S-站立, C-蹲, A-空中
;常用的控制器:
velset = 0,0                     ;设定速度 (x,y) (不写这行则不改变速度)
ctrl = 0                         ;设定可控与否 (不写这行则不改变ctrl)
anim = 200                       ;改变动作 (不写这行则不改变anim)
sprpriority = 2                  ;设定p1的贴图优先度到2 (在前面)

;---------------------------------------------------------------------------
;宽度调整
[State 0, Width]
type = Width
trigger1 = 1
edge = 30,0
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;速度
[State 0, VelSet]
type = VelSet
trigger1 = time = 4
x = 8
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;攻击判定
[State 200, 1]
type = HitDef
trigger1 = AnimElem = 3
attr = S, NA                     ;Hitdef属性： 站立，普通攻击
damage = 40, 0                   ;招式造成的伤害, 防御伤害
getpower = 70,70
givepower = 20,0
animtype = Light                 ;动作种类: Light-轻, Medium-中, Heavy-重, Back-后仰 (默认: Light)
guardflag = HA                   ;能被什么状态的敌人防御
hitflag = MAF                    ;能击中什么状态的敌人
priority = 4, Hit                ;攻击优先度: 0 (最低) to 7 (最高), 4 默认，相杀式的处理：Hit-可以击中非dodge情况的敌方/Miss-我方攻击一定miss/Dodge-一定躲避敌方攻击 (默认: Hit)
pausetime = 8, 8                 ;攻击者暂停的时间, 对手在hitshake的时间
sparkno = -1                      ;火花的动作号 (默认: 在上面设置的动作好)
sparkxy = -8, -75               ;火花相对于p2的X坐标偏移量，火花相对于p1的Y坐标偏移量
guard.sparkno = -1
hitsound = S400, 0                  ;击中时播放的音效
guardsound = S100, 8                ;被防御时播放的音效
ground.type = High               ;种类: High-上段, Low-下段, Trip-绊倒 (默认: Normal)
ground.slidetime = 4             ;对方向后滑的时间
ground.hittime = 15             ;对方在被击中状态的时间
guard.ctrltime = 15             ;对方在防御状态的时间
ground.velocity = -2             ;对方被向后推的速度
airguard.velocity = -1.9,-.8     ;空中防御的速度 (默认: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;空中击中的种类: High-上段, Low-下段, Trip-绊倒 (默认: 和ground.type一样)
air.velocity = -1,-3           ;空中击中时对方被向后推的横向速度, 空中击中时对方被向后推的纵向速度
air.hittime = 15                 ;空中击中对方在被击中状态的时间、
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
down.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
ID = 200

;---------------------------------------------------------------------------
;敌方状态控制
[State 0, TargetState]
type = TargetState
triggerall = NumTarget
trigger1 = target,statetype != A
trigger1 = movehit = 1
value = 205
ignorehitpause = 1
persistent = 0

[State 0, TargetState]
type = TargetState
triggerall = NumTarget
trigger1 = target,statetype = A
trigger1 = movehit = 1
value = 206
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;打击火花与防御火花
[State 0, 打击火花]
type = Explod
trigger1 = movehit = 1
anim = 6000
pos = facing*(Enemynear,Pos X - Pos X),-75
postype = p1
facing = 1
bindtime = 1
vel = 0,0
removetime = -2
pausemovetime = 999999
supermovetime = 999999
scale = 0.8,0.8
sprpriority = 999
ontop = 1
ownpal = 1
ignorehitpause = 1
persistent = 0

[State 0, 防御火花]
type = Explod
trigger1 = MoveGuarded = 1
anim = 6003
pos = facing*(Enemynear,Pos X - Pos X),-75
postype = p1
facing = -1
bindtime = 1
vel = 0,0
removetime = -2
pausemovetime = 999999
supermovetime = 999999
scale = 0.8,0.8
sprpriority = 999
ontop = 1
ownpal = 1
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;音效

[State 200, 2]
type = PlaySnd
triggerall = random <= 200
trigger1 = time = 3
value = s0, 0

[State 200, 挥动音效]
type = PlaySnd
trigger1 = animelem = 2
value = s4, 0

;---------------------------------------------------------------------------
;继续攻击

[State 200, 3]
type = ChangeState
triggerall = var(59) = 0
trigger1 = time >= 12 || MoveContact
trigger1 = command = "x"
trigger1 = command != "/2"
value = 210
ctrl = 0

[State 200, 4]
type = ChangeState
triggerall = var(59) = 0
trigger1 = MoveContact
trigger1 = command = "y"
trigger1 = command != "/2"
value = 240
ctrl = 0

[State 200, 5]
type = ChangeState
triggerall = var(59) = 0
trigger1 = MoveContact
trigger1 = command = "y"
trigger1 = command = "/2"
value = 430
ctrl = 0

[State 200, 6]
type = ChangeState
triggerall = var(59) = 0
trigger1 = MoveContact
trigger1 = command = "b"
trigger1 = command != "/2"
value = 300
ctrl = 0

;---------------------------------------------------------------------------
;状态转出
[State 200, 8]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;拉p2
[statedef 205, 地面p2]
type    = S
movetype= H
physics = S
poweradd = 0
VelSet = 0,0
ctrl = 0
sprpriority = -2
facep2 = 1

;---------------------------------------------------------------------------
;helper销毁
[State 0, DestroySelf]
type = DestroySelf
trigger1 = ishelper
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;动画改变
[state 0]
type = changeAnim2
Trigger1 = time = 0
value = 205

;---------------------------------------------------------------------------
;速度设置
[State 0, VelSet]
type = VelSet
trigger1 = time = 9
x = -3
y = 0
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;状态转出
[State 0, selfState]
type = selfState
trigger1 = AnimTime = 0
trigger1 = Vel X >= 0
value = 0
ctrl = 1

[statedef 206, 空中p2（受击）]
type    = A
movetype= H
physics = N
poweradd = 0
VelSet = 0,0
ctrl = 0
sprpriority = -2
facep2 = 1

;---------------------------------------------------------------------------
;helper销毁
[State 0, DestroySelf]
type = DestroySelf
trigger1 = ishelper
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;动画改变
[state 0]
type = changeAnim2
Trigger1 = time = 0
value = 206

;---------------------------------------------------------------------------
;速度设置
[State 0, VelSet]
type = VelSet
trigger1 = time = 12
x = -1
y = -4
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;状态转出
[State 0, ChangeState]
type = ChangeState
trigger1 = time >= 16
value = 207
ctrl = 0

[statedef 207, 空中p2（下落）]
type    = A
movetype= H
physics = N
poweradd = 0
ctrl = 0
sprpriority = -2

;---------------------------------------------------------------------------
;动画改变
[state 0]
type = changeAnim2
Trigger1 = time = 0
value = 207

;---------------------------------------------------------------------------
;速度设置

[State 0, VelAdd]
type = VelAdd
trigger1 = Vel Y < 8
y = 0.6
ignorehitpause = 1
persistent = 1

[State 0, 速度修正]
type = VelSet
trigger1 = Vel Y >= 8
y = 8
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;状态转出
[State 0, ChangeState]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 4935 ;Hit ground
ctrl = 0

