[State 0, 打击火花]
type = Explod
trigger1 = movehit = 1
anim = 6001
pos = facing*(Enemynear,Pos X - Pos X),-75
postype = p1
facing = 1
bindtime = 1
vel = 0,0
removetime = -2
pausemovetime = 999999
supermovetime = 999999
scale = 0.8,0.8
sprpriority = 999
ontop = 1
ownpal = 1
ignorehitpause = 1
persistent = 0

[State 0, 防御火花]
type = Explod
trigger1 = MoveGuarded = 1
anim = 6003
pos = facing*(Enemynear,Pos X - Pos X),-75
postype = p1
facing = -1
bindtime = 1
vel = 0,0
removetime = -2
pausemovetime = 999999
supermovetime = 999999
scale = 1,1
sprpriority = 999
ontop = 1
ownpal = 1
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;音效

[State 610, 2]
type = PlaySnd
triggerall = random <= 500
trigger1 = time = 5
value = s0, 1

[State 610, 挥动音效]
type = PlaySnd
trigger1 = animelem = 2
value = s4, 1

;---------------------------------------------------------------------------
;继续攻击

[State 610, 3]
type = ChangeState
triggerall = var(59) = 0
trigger1 = MoveContact
trigger1 = command = "x"
trigger1 = PrevStateNo != 600
value = 600
ctrl = 0

[State 600, 4]
type = ChangeState
triggerall = var(59) = 0
trigger1 = MoveContact
trigger1 = command = "x"
trigger1 = PrevStateNo = 600
value = 620
ctrl = 0

[State 600, 5]
type = ChangeState
triggerall = var(59) = 0
trigger1 = MoveContact
trigger1 = command = "b"
trigger1 = command != "/2"
value = 620
ctrl = 0

[State 600, 6]
type = ChangeState
triggerall = var(59) = 0
trigger1 = MoveContact
trigger1 = command = "b"
trigger1 = command = "/2"
value = 630
ctrl = 0

;---------------------------------------------------------------------------
;空中重攻击
[Statedef 620]
type    = A                      ;状态: S-站立, C-蹲, A-空中, L-倒地
movetype= A                      ;招式种类: A-攻击, I-非攻击, H-受击
physics = A                      ;物理: S-站立, C-蹲, A-空中
;常用的控制器:
ctrl = 0                         ;设定可控与否 (不写这行则不改变ctrl)
anim = 620                       ;改变动作 (不写这行则不改变anim)
sprpriority = 2                  ;设定p1的贴图优先度到2 (在前面)

;---------------------------------------------------------------------------
;宽度调整
[State 0, Width]
type = Width
trigger1 = 1
edge = 30,0
player = 0,0
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;可控调整
[State 0, CtrlSet]
type = CtrlSet
trigger1 = time >= 22
value = 1
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;速度调整
[State 0, 下落速度修正]
type = VelSet
trigger1 = time <= 18
trigger1 = movehit
trigger1 = target,statetype = A
y = 0
ignorehitpause = 1
persistent = 1

[State 0, 下落速度修正]
type = VelSet
trigger1 = Vel Y > 8
y = 8
ignorehitpause = 1
persistent = 1

