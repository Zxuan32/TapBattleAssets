;---------------------------------------------------------------------------
; 每一帧执行(statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

;---------------------------------------------------------------------------
;变量还原

[State 0, 跳跃和冲刺限制]
type = VarSet
trigger1 = statetype != A
v = 5
value = 0
ignorehitpause = 1
persistent = 1

[State 0, 追击冲刺限制]
type = VarSet
trigger1 = statetype != A
v = 6
value = 0
ignorehitpause = 1
persistent = 1

[State 0, 超能力抓取限制]
type = VarSet
trigger1 = Enemynear(var(58)),movetype != H
v = 7
value = 0
ignorehitpause = 1
persistent = 1

[State 0, 瞬移限制]
type = VarSet
trigger1 = statetype != A
v = 8
value = 0
ignorehitpause = 1
persistent = 1

[State 0, 普通特写变量]
type = VarSet
trigger1 = Enemynear(var(58)),movetype != H
v = 9
value = 0
ignorehitpause = 1
persistent = 1

[State 0, 瞬移特写变量]
type = VarSet
trigger1 = Enemynear(var(58)),movetype != H
v = 10
value = 0
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;连击修正

[State 0, 连击数记录]
type = VarAdd
triggerall = fvar(8) = 0.6
trigger1 = movehit = 1
v = 12
value = 1
ignorehitpause = 1
persistent = 0

[State 0, 连击数记录2]
type = VarAdd
triggerall = fvar(8) = 0.4
trigger1 = movehit = 1
v = 12
value = 2
ignorehitpause = 1
persistent = 0

[State 0, 连击数记录3]
type = VarAdd
triggerall = fvar(8) = 0.35
trigger1 = movehit = 1
v = 12
value = 2
ignorehitpause = 1
persistent = 0

[State 0, 连击数记录4]
type = VarAdd
triggerall = fvar(8) = 0.2
trigger1 = movehit = 1
v = 12
value = 2
ignorehitpause = 1
persistent = 0

[State 0, 记录修正]
type = VarSet
triggerall = fvar(8) = 0.6
trigger1 = var(12) > 30
v = 12
value = 30
ignorehitpause = 1
persistent = 1

[State 0, 记录修正2]
type = VarSet
triggerall = fvar(8) = 0.4
trigger1 = var(12) > 30
v = 12
value = 30
ignorehitpause = 1
persistent = 1

[State 0, 记录修正3]
type = VarSet
triggerall = fvar(8) = 0.35
trigger1 = var(12) > 35
v = 12
value = 35
ignorehitpause = 1
persistent = 1

[State 0, 记录修正4]
type = VarSet
triggerall = fvar(8) = 0.2
trigger1 = var(12) > 20
v = 12
value = 20
ignorehitpause = 1
persistent = 1

[State 0, 记录清零]
type = VarSet
trigger1 = Enemynear(var(58)),movetype != H
v = 12
value = 0
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;攻击系数设置
[State 0, 攻击系数]
type = AttackMulSet
trigger1 = 1
value = 1 - fvar(8) - (0.01*var(12))
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;敌方位置检测
[State 0, VarSet]
type = VarSet
trigger1 = Numtarget
trigger1 = target,ishelper != 1
v = 15
value = ((target,pos X)-pos X)*facing
ignorehitpause = 1
persistent = 1

[State 0, VarSet]
type = VarSet
trigger1 = Numtarget
trigger1 = target,ishelper != 1
v = 16
value = ((target,pos Y)-pos Y)
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;敌方状态和时间检测
[State 0, VarSet]
type = VarSet
trigger1 = Numtarget
trigger1 = target,ishelper != 1
v = 17
value = target,stateno
ignorehitpause = 1
persistent = 1

[State 0, VarSet]
type = VarSet
trigger1 = Numtarget
trigger1 = target,ishelper != 1
v = 18
value = target,time
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;敌方到背部屏幕边缘距离
[State 0, VarSet]
type = VarSet
trigger1 = Numtarget
trigger1 = target,ishelper != 1
v = 19
value = target,BackEdgeBodyDist
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;敌方速度
[State 0, 横轴速度]
type = VarSet
trigger1 = 1
fv = 4
value = facing*enemynear(var(58)),facing*enemynear(var(58)),Vel X
ignorehitpause = 1
persistent = 1

[State 0, 纵轴速度]
type = VarSet
trigger1 = 1
fv = 5
value = Enemynear(var(58)),Vel Y
ignorehitpause = 1
persistent = 1

