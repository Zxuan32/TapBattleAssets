persistent = 1

;---------------------------------------------------------------------------
;敌方最大生命值
[State 0, VarSet]
type = VarSet
trigger1 = 1
fv = 10
value = Enemynear(var(58)),lifemax
ignorehitpause = 1
persistent = 1

;-----------------------------------------------------------------------------
; AI用重力加速度测量
;-----------------------------------------------------------------------------
[State -2, yaccel]
type = VarSet
triggerall = NumHelper(30000)
triggerall = EnemyNear(var(58)),Vel Y != 0
triggerall = EnemyNear(var(58)),Pos Y < (((EnemyNear(var(58)),Anim != [5051,5059]) && (EnemyNear(var(58)),Anim != [5061,5069])) && (EnemyNear(var(58)),StateNo = 5050))*25 ;参考Statedef 5050
triggerall = fvar(20) != Helper(30000),fvar(0)
trigger1 = EnemyNear(var(58)),StateNo != [5000,5210]
trigger2 = EnemyNear(var(58)),Movetype != H
fv = 20
value = Helper(30000),fvar(0)
IgnoreHitPause = 1

[State -2, yaccel]
type = VarSet
triggerall = EnemyNear(var(58)),Vel Y != 0
triggerall = EnemyNear(var(58)),Movetype = H
triggerall = EnemyNear(var(58)),Pos Y < (((EnemyNear(var(58)),Anim != [5051,5059]) && (EnemyNear(var(58)),Anim != [5061,5069])) && (EnemyNear(var(58)),StateNo = 5050))*25 ;参考Statedef 5050
triggerall = fvar(20) != EnemyNear(var(58)),GetHitVar(yaccel)
trigger1 = EnemyNear(var(58)),StateNo = [5000,5210]
fv = 20
value = EnemyNear(var(58)),GetHitVar(yaccel)
IgnoreHitPause = 1

;敌人不在空中时
[State -2, yaccel]
type = VarSet
trigger1 = fvar(20) != 0 && EnemyNear(var(58)),Vel Y = 0
fv = 20
value = 0
IgnoreHitPause = 1

;================================================================当身记录
[State 当身记录]
type = VarSet
trigger1 = var(21) = 0
trigger1 = MoveReversed
v = 21
value = enemynear(var(58)),prevstateno
ignorehitpause = 1

[State 当身记录]
type = VarSet
trigger1 = var(22) = 0
trigger1 = MoveReversed
V = 22
value = enemynear(var(58)),stateno
ignorehitpause = 1

[State 当身记录]
type = VarSet
trigger1 = var(23) = 0
trigger1 = var(21) != 0
trigger1 = MoveReversed
trigger1 = var(21) != enemynear(var(58)),prevstateno
v = 23
value = enemynear(var(58)),prevstateno
ignorehitpause = 1

[State 当身记录]
type = VarSet
trigger1 = var(24) = 0
trigger1 = var(22) != 0
trigger1 = MoveReversed
trigger1 = var(22) != enemynear(var(58)),stateno
V = 24
value = enemynear(var(58)),stateno
ignorehitpause = 1

;---------------------------------------------------------------------------
;回气系统
[State 0, PowerAdd]
type = PowerAdd
trigger1 = Vel X > 0
trigger1 = stateno <= 700
trigger1 = gametime%5 = 1
value = Abs(Vel X)*Abs((enemynear,pos X)-pos X)*0.1
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;电击辅助效果

[State 6050,电击辅助效果]
type = Explod
triggerall = Numtarget
triggerall = random < 200
triggerall = target,ishelper != 1
triggerall = target,movetype = H
trigger1 = Projhittime(790) >= 0 && Projhittime(790) <= 35
anim = 6050
ID = 6050
postype = P2
pos = -10,-60
random = 40,90
velocity = 0,0
bindtime = 1
sprpriority = 3
ownpal = 1
ignorehitpause = 1

[State 6055,电击辅助效果2]
type = Explod
triggerall = Numtarget
triggerall = random < 100
triggerall = target,ishelper != 1
triggerall = target,movetype = H
trigger1 = Projhittime(790) >= 0 && Projhittime(790) <= 35
anim = 6055
ID = 6055
postype = P2
pos = -10,-60
random = 40,90
velocity = 0,0
bindtime = 1
sprpriority = 3
ownpal = 1
ignorehitpause = 1

;---------------------------------------------------------------------------
;记录屏幕宽高helper

[State 0, Helper]
type = Helper
triggerall = !ishelper
triggerall = roundstate = 2
trigger1 = !numhelper(40000)
helpertype = normal
name = "40000"
ID = 40000
stateno = 40000
pos = 0,0
postype = p1
facing = 1
keyctrl = 0
ownpal = 1
supermovetime = 999999999
pausemovetime = 999999999
ignorehitpause = 1
persistent = 0

