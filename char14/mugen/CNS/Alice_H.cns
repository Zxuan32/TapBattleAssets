trigger1 = time = 0
anim = 2005
ID = 2005
pos = 0,0
postype = p1
facing = 1
bindtime = 1
vel = 0,0
removetime = -2
pausemovetime = 999999
supermovetime = 999999
scale = 50,50
sprpriority = -3
ownpal = 1
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;闪烁特效

[State 0, 闪烁特效]
