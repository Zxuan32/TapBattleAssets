;---------------------------------------------------------------------------
;MAX空间移动
[Statedef 2000]
type    = S                      ;状态: S-站立, C-蹲, A-空中, L-倒地
movetype= I                      ;招式种类: A-攻击, I-非攻击, H-受击
physics = S                      ;物理: S-站立, C-蹲, A-空中
;常用的控制器:
velset = 0,0                     ;设定速度 (x,y) (不写这行则不改变速度)
ctrl = 0                         ;设定可控与否 (不写这行则不改变ctrl)
anim = 2000                       ;改变动作 (不写这行则不改变anim)
sprpriority = 3                  ;设定p1的贴图优先度到2 (在前面)

;---------------------------------------------------------------------------
;宽度调整
[State 0, Width]
type = Width
trigger1 = 1
edge = 30,0
player = 10,0
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;无敌
[State 0, 无敌]
type = NotHitBy
trigger1 = 1
value = SCA
time = 3

;---------------------------------------------------------------------------
;超级暂停
[State 0, SuperPause]
type = SuperPause
trigger1 = time = 0
time = 70
anim = -1
sound = -1
pos = -1
movetime = 70
darken = 0
poweradd = 0
p2defmul = 1
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;消耗能量

[State 0, 消耗能量]
type = PowerAdd
trigger1 = time = 5
value = -1000
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;震屛
[State 0, EnvShake]
type = EnvShake
trigger1 = time = 6
time = 20
freq = 45
ampl = -4
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;超必杀闪光
[State 0, 超必杀闪光]
type = Explod
trigger1 = time = 5
anim = 15000
pos = 2,-70
postype = p1
facing = 1
bindtime = 1
removetime = -2
pausemovetime = 999999
supermovetime = 999999
scale = 0.4,0.4
sprpriority = -2
ownpal = 1
ignorehitpause = 1

[State 0, 超必杀闪光2]
type = Explod
trigger1 = time = 5
anim = 15001
pos = 2,-70
postype = p1
facing = 1
bindtime = 1
removetime = -2
pausemovetime = 999999
supermovetime = 999999
scale = 0.4,0.4
sprpriority = 10
ownpal = 1
ignorehitpause = 1

[State 0, 超必杀音效]
type = PlaySnd
trigger1 = time = 5
value = S10000, 0
volumescale = 80

[State 0, 超必杀音效]
type = PlaySnd
trigger1 = time = 5
value = S10000, 1
volumescale = 80

