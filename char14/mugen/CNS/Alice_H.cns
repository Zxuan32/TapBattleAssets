trigger1 = time = 40
anim = 802
ID = 802
pos = 4,16
postype = p1
facing = 1
bindtime = 1
vel = 0,0
removetime = -2
removeongethit = 1
pausemovetime = 999999
supermovetime = 999999
scale = 1.5,1
sprpriority = -2
ownpal = 1

;---------------------------------------------------------------------------
;瞬移

[state 0, 瞬移]
type = posadd
trigger1 = time = 59
x = ((enemynear,pos X)-pos X)*facing + 50

[State 0, Y轴坐标修正]
type = PosSet
trigger1 = time = 59
y = 0

;---------------------------------------------------------------------------
;音效

[State 0, 人物音效]
type = PlaySnd
trigger1 = time = 0
value = s2,0

[State 0, 闪烁音效]
type = PlaySnd
trigger1 = time = 40
value = s8,1
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;状态转出
[State 2000, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 2010
ctrl = 0

;---------------------------------------------------------------------------
;空中p2
[statedef 2006, 空中p2]
type    = A
movetype= H
physics = N
poweradd = 0
VelSet = 0,0
ctrl = 0
sprpriority = -2
facep2 = 1

;---------------------------------------------------------------------------
;helper销毁
[State 0, DestroySelf]
type = DestroySelf
trigger1 = ishelper
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;动画改变
[state 0]
type = changeAnim2
Trigger1 = time = 0
value = 206

;---------------------------------------------------------------------------
;速度设置
[State 0, VelSet]
type = VelSet
trigger1 = time = 12
x = -2
y = -3
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;状态转出
[State 0, ChangeState]
type = ChangeState
trigger1 = time >= 16
value = 2007
ctrl = 0

[statedef 2007, 空中下落]
type    = A
movetype= H
physics = N
poweradd = 0
ctrl = 0
sprpriority = -2

;---------------------------------------------------------------------------
;动画改变
[state 0]
type = changeAnim2
Trigger1 = time = 0
value = 207

;---------------------------------------------------------------------------
;速度设置

[State 0, VelAdd]
type = VelAdd
trigger1 = Vel Y < 8
y = 0.6
ignorehitpause = 1
persistent = 1

[State 0, 速度修正]
type = VelSet
trigger1 = Vel Y >= 8
y = 8
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;状态转出
[State 0, ChangeState]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 4935 ;Hit ground
ctrl = 0

;---------------------------------------------------------------------------
;MAX空间移动攻击
[Statedef 2010]
type    = S                      ;状态: S-站立, C-蹲, A-空中, L-倒地
movetype= A                      ;招式种类: A-攻击, I-非攻击, H-受击
physics = S                      ;物理: S-站立, C-蹲, A-空中
;常用的控制器:
velset = 0,0                     ;设定速度 (x,y) (不写这行则不改变速度)
ctrl = 0                         ;设定可控与否 (不写这行则不改变ctrl)
anim = 2010                       ;改变动作 (不写这行则不改变anim)
sprpriority = 3                  ;设定p1的贴图优先度到2 (在前面)

;---------------------------------------------------------------------------
;转身

[State 0, Turn]
type = Turn
trigger1 = time = 1
trigger1 = facing*(EnemyNear(var(58)),Pos X - Pos X) < 0
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;宽度调整
[State 0, Width]
type = Width
trigger1 = 1
edge = 30,0
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;攻击判定
[State 2010,1]
type = HitDef
trigger1 = AnimElem = 4
attr = S, NA                     ;Hitdef属性： 站立，普通攻击
damage = 30, 0                   ;招式造成的伤害, 防御伤害
getpower = 0,0
givepower = 30,0
animtype = Medium                 ;动作种类: Light-轻, Medium-中, Heavy-重, Back-后仰 (默认: Light)
guardflag = LA                   ;能被什么状态的敌人防御
hitflag = MAFD                   ;能击中什么状态的敌人
priority = 5, Hit                ;攻击优先度: 0 (最低) to 7 (最高), 4 默认，相杀式的处理：Hit-可以击中非dodge情况的敌方/Miss-我方攻击一定miss/Dodge-一定躲避敌方攻击 (默认: Hit)
pausetime = 12, 12                 ;攻击者暂停的时间, 对手在hitshake的时间
sparkno = -1                      ;火花的动作号 (默认: 在上面设置的动作好)
sparkxy = -8, -75               ;火花相对于p2的X坐标偏移量，火花相对于p1的Y坐标偏移量
guard.sparkno = -1
hitsound = S400, 3                  ;击中时播放的音效
guardsound = S100, 9                ;被防御时播放的音效
ground.type = High               ;种类: High-上段, Low-下段, Trip-绊倒 (默认: Normal)
ground.slidetime = 4             ;对方向后滑的时间
ground.hittime = 20             ;对方在被击中状态的时间
guard.ctrltime = 20             ;对方在防御状态的时间
ground.velocity = -2             ;对方被向后推的速度
airguard.velocity = -1.9,-.8     ;空中防御的速度 (默认: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;空中击中的种类: High-上段, Low-下段, Trip-绊倒 (默认: 和ground.type一样)
air.velocity = -1,-3           ;空中击中时对方被向后推的横向速度, 空中击中时对方被向后推的纵向速度
air.hittime = 20                 ;空中击中对方在被击中状态的时间、
envshake.ampl = 6
envshake.freq = 45
envshake.time = 12
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
down.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
ID = 2010
kill = 0

