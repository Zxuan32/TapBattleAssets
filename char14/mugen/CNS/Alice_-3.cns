triggerall = EnemyNear(var(58)),statetype = L ;对方在倒地状态
trigger1 = (EnemyNear(var(58)),pos x - pos x)*facing >= 120;与对方的绝对值距离大于等于120
trigger1 = ctrl || stateno = 0 || (stateno = [10,12]) || (stateno = [21,22]) || stateno = 52 || (stateno = [120,149])
value = 100

;对方倒地时移动
[State -3,移动]
type = changestate
triggerall = !ishelper;不是helper
triggerall = alive != 0
triggerall = var(59) >= 1;ai启动
triggerall = roundstate = 2;在对局中
triggerall = statetype != a;自己不在空中
triggerall = stateno != 22;自己不在22状态号中
triggerall = !inguarddist;自己不在防御范围
triggerall = EnemyNear(var(58)),stateno != 5120
triggerall = EnemyNear(var(58)),statetype = L ;对方在倒地状态
trigger1 = (EnemyNear(var(58)),pos x - pos x)*facing > 80;与对方的绝对值距离大于等于80
trigger1 = ctrl || stateno = 0 || (stateno = [20,21])
value = 22

;对方起身时移动2
[State -3,移动2]
type = changestate
triggerall = !ishelper;不是helper
triggerall = alive != 0
triggerall = var(59) >= 1;ai启动
triggerall = roundstate = 2;在对局中
triggerall = statetype != a;自己不在空中
triggerall = stateno != 22;自己不在22状态号中
triggerall = !inguarddist;自己不在防御范围
triggerall = EnemyNear(var(58)),stateno = 5120
trigger1 = (EnemyNear(var(58)),pos x - pos x)*facing < 150;与对方的绝对值距离小于150
trigger1 = ctrl || stateno = 0 || (stateno = [20,22])
value = 22























