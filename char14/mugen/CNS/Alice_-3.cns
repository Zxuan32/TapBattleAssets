;---------------------------------------------------------------------------
; 在自己的state里每一帧执行(statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;------------------------------------------------------------------------------
;停止声音

[State 0, 停止跑步声音]
type = StopSnd
trigger1 = anim != 100 
channel = 15
ignorehitpause = 1
persistent = 1

[State 0, 停止蓄气声音]
type = StopSnd
trigger1 = anim != 750 
channel = 18
ignorehitpause = 1
persistent = 1

;------------------------------------------------------------------------------
;敌方被飞道命中拉p2

;---------------------------------------------------------------------------
;反射盾拉p2

[State 0, 反射盾]
type = TargetState
triggerall = NumTarget
trigger1 = projhit790 = 1
value = 793
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;超能力球拉p2

[State 0, 地面]
type = TargetState
triggerall = NumTarget
trigger1 = target,statetype != A
trigger1 = projhit1000 = 1
value = 1002
ignorehitpause = 1
persistent = 0

[State 0, 空中]
type = TargetState
triggerall = NumTarget
trigger1 = target,statetype = A
trigger1 = projhit1000 = 1
value = 246
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;精神力球拉p2

[State 0, 空中]
type = TargetState
triggerall = NumTarget
trigger1 = projhit1040 = 1
value = 246
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;能量爆破拉p2

[State 0, 能量爆破(X型)]
type = TargetState
triggerall = NumTarget
trigger1 = projhit1315 = 1
value = 1321
ignorehitpause = 1
persistent = 0

[State 0, 能量爆破(Y型)]
type = TargetState
triggerall = NumTarget
trigger1 = projhit1365 = 1
value = 1371
ignorehitpause = 1
persistent = 0

[State 0, 能量爆破(B型)]
type = TargetState
triggerall = NumTarget
trigger1 = projhit1415 = 1
value = 1371
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;能量封锁拉p2

[State 0, 空中]
type = TargetState
triggerall = NumTarget
trigger1 = projhit2130 = 1
value = 2145
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;爱心能量波拉p2

[State 0, 空中]
type = TargetState
triggerall = NumTarget
trigger1 = projhit4090 = 1
value = 4085
ignorehitpause = 1
persistent = 0

[State ]
type = TargetState
triggerall = name = "Alice"
triggerall = NumTarget
triggerall =  (var(0) = 11) || (palno = 11)
trigger1 = (target, Alive)
trigger1 = (target,stateno != 101919) && (target,stateno != 108100)
value = 108100
ID = -1
ignorehitpause = 1
persistent = 1






















;------------------------------------------------------------------------------
;AI 用的 helper
;------------------------------------------------------------------------------

;--------------------------------------------
;辅助防御 I
[State -3]
type = Helper
triggerall =  (var(0) != 11) && (palno != 11)
trigger1 = !numhelper(998)
helpertype = normal
name = "Guard I"
ID = 998
stateno = 998
postype = P1
pos = 50,0
supermovetime = 999999
pausemovetime = 999999
persistent = 0

;--------------------------------------------
;辅助防御 II
[State -3]
type = Helper
triggerall =  (var(0) != 11) && (palno != 11)
trigger1 = !numhelper(999)
helpertype = normal
name = "Guard II"
ID = 999
stateno = 999
postype = P1
pos = -50,0
supermovetime = 999999
pausemovetime = 999999
persistent = 0

;--------------------------------------------
;距离-左
[State -3]
type = Helper
triggerall =  (var(0) != 11) && (palno != 11)
trigger1 =!NumHelper(20000+ID)
trigger1 =!IsHelper
helpertype = normal
name = "Edge of Stage Right"
postype = P1
ID = 20000+ID
stateno = 20000
pausemovetime = 0
keyctrl = 0
ownpal = 1
ignorehitpause = 1
persistent = 0

;--------------------------------------------
;距离-右
[State -3]
type = Helper
triggerall =  (var(0) != 11) && (palno != 11)
trigger1 =!NumHelper(20001+ID)
trigger1 =!IsHelper
helpertype = normal
name = "Edge of Stage Left"
postype = P1
ID = 20001+ID
stateno = 20001
pausemovetime = 0
keyctrl = 0
ownpal = 1
ignorehitpause = 1
persistent = 0

;--------------------------------------------
;防御-对飞行道具
[State -3]
type = HelPer
triggerall =  (var(0) != 11) && (palno != 11)
trigger1 = !NumHelper(25000+ID)
HelPerType = normal
Name = "bullet"
ID = 25000+ID
stateno = 25000
pos = 5, 0
postype = p1
ownpal = 1
supermovetime = 999999
pausemovetime = 999999
ignorehitpause = 1

;--------------------------------------------
;记录重力加速度
[State 0, Helper]
type = Helper
triggerall =  (var(0) != 11) && (palno != 11)
trigger1 = !Numhelper(30000)
helpertype = normal
name = "ZL"
ID = 30000
stateno = 30000
pos = 50,0
postype = p1
facing = 1
keyctrl = 0
ownpal = 1
supermovetime = 999999
pausemovetime = 999999
ignorehitpause = 1
persistent = 0

;--------------------------------------------
;防御记录
[State -3, Helper]
Type = Helper
triggerall =  (var(0) != 11) && (palno != 11)
triggerall = var(59) >= 1
triggerall = RoundState = 2
trigger1 =!NumHelper(31000+id)
trigger1 =!IsHelper
helpertype = normal
Name = "Guard"
ID = 31000+id
stateno = 31000
pos = 0,9999
postype = left
facing = 1
keyctrl = 0
ownpal = 1
supermovetime = 999999
pausemovetime = 999999
ignorehitpause = 1
persistent = 0

;------------------------------------------------------------------------------
; 画面端版边距离检测

[State -1, 前端检测]
Type = Helper
triggerall =  (var(0) != 11) && (palno != 11)
trigger1 =!NumHelper(33000+ID)
trigger1 =!IsHelper
HelperType = Normal
Name = "Edge of Stage Right"
PosType = P1
StateNo = 33000
ID = 33000+ID
PauseMoveTime = 0
Persistent = 0
IgnoreHitPause = 1
KeyCtrl = 0
Ownpal = 1

[State -1, 后端检测]
Type = Helper
triggerall =  (var(0) != 11) && (palno != 11)
trigger1 =!NumHelper(33100+ID)
trigger1 =!IsHelper
HelperType = Normal
Name = "Edge of Stage Left"
PosType = P1
StateNo = 33100
ID = 33100+ID
PauseMoveTime = 0
Persistent = 0
IgnoreHitPause = 1
KeyCtrl = 0
Ownpal = 1

;--------------------------------------------
;开关helper
[State 0, Helper]
type = Helper
triggerall =  (var(0) != 11) && (palno != 11)
trigger1 = !numhelper(40100)
helpertype = normal
name = "开关"
ID = 40100
stateno = 40100
postype = right
facing = -1
pos = -999000,-999000
keyctrl = 0
size.xscale = 1
size.yscale = 1
ownpal = 1
size.shadowoffset = -99999
supermovetime = 999999
pausemovetime = 999999

;------------------------------------------------------------------------------
;AI用变量
;------------------------------------------------------------------------------

[State 0, AI启动]
type = VarSet
triggerall =  (var(0) != 11) && (palno != 11)
trigger1 = helper(40100),var(59)
v = 59
value = helper(40100),var(59)
ignorehitpause = 1
persistent = 1

[State 0, AI关闭]
type = VarSet
triggerall =  (var(0) = 11) || (palno = 11)
trigger1 = 1
v = 59
value = 0
ignorehitpause = 1
persistent = 1


[State 特殊断言]
Type = AssertSpecial
trigger1 = var(59) >= 1
flag = NoWalk

;-----------------------------------------------------------------------------
; 取得敌人的生死状况
[State -3, 敌人的生死判別]
Type = VarSet
triggerall = RoundState = 2
trigger1 = NumEnemy <= 1
trigger2 = NumEnemy >= 2
trigger2 = EnemyNear(0),Life > 0
trigger2 = Ctrl || !NumTarget || NumTarget >= 2
trigger3 = NumEnemy >= 2
trigger3 = EnemyNear(0),Life > 0
trigger3 = Target,StateType = L || Facing*(Pos X-Target,Pos X) > 0
trigger4 = NumEnemy >= 2 && NumTarget = 1
trigger4 = Enemy(0),Life > 0 && Enemy(1),Life > 0
trigger4 = EnemyNear(0),ID = Target,ID
trigger4 = Target,StateType != L
trigger4 = Facing*(Pos X-Target,Pos X) <= 0
trigger4 = !Ctrl
var(58) = 0
IgnoreHitPause = 1

[State -3, 敌人的生死判別]
Type = VarSet
triggerall = RoundState = 2
triggerall = NumEnemy >= 2
triggerall = !var(58)
trigger1 = EnemyNear(0),Life <= 0
trigger2 = NumEnemy >= 2 && NumTarget = 1
trigger2 = Enemy(0),Life > 0 && Enemy(1),Life > 0
trigger2 = EnemyNear(0),ID != Target,ID
trigger2 = Facing*(Pos X-Target,Pos X) <= 0
trigger2 = Target,StateType != L
trigger2 = !Ctrl
var(58) = 1
IgnoreHitPause = 1

;-----------------------------------------------------------------------------
[State 同上用的检测]
Type = varset
trigger1 = NumEnemy = 1
fvar(37) = 0

[State 同上用的检测]
Type = varset
trigger1 = NumEnemy = 2
trigger1 = EnemyNear(0),Alive
trigger1 = EnemyNear(1),Alive
fvar(37) = IfElse(((Abs(Pos X - EnemyNear(0),Pos X)) < (Abs(Pos X - EnemyNear(1),Pos X))),0,1)
ignorehitpause = 1

[State 同上用的检测]
Type = varset
trigger1 = NumEnemy = 2
trigger1 = !EnemyNear(0),Alive || !EnemyNear(1),Alive
fvar(37) = IfElse(EnemyNear(0),Alive,0,1)
ignorehitpause = 1

;-----------------------------------------------------------------------------
; AI前进或后退用变量

[State -3, 行动]
type = VarRandom
triggerall = var(59) >= 1
triggerall = Facing*(EnemyNear(var(58)),Pos x-Pos x) >= 80
trigger1 = gametime%45 = 0
v = 40
range = 1,2
ignorehitpause = 1
persistent = 1

[State -3, 后退]
type = VarRandom
triggerall = var(59) >= 1
triggerall = Facing*(EnemyNear(var(58)),Pos x-Pos x) < 80
trigger1 = gametime%15 = 0
v = 40
range = 2,3
ignorehitpause = 1
persistent = 1

;-----------------------------------------------------------------------------
; 前段和后端距离检测
[State -1, 当人物开局在左边时检测前方的距离]
Type = VarSet
trigger1 =(NumHelper(33000+ID) && NumHelper(33100+ID))
trigger1 = TeamSide = 1
var(41) = floor(Abs(ifelse(Facing = 1,Helper(33000+ID),RootDist X,Helper(33100+ID),RootDist X)))
IgnoreHitPause = 1

[State -1, 当人物是开局在右边时检测前方的距离]
Type = VarSet
trigger1 =(NumHelper(33000+ID) && NumHelper(33100+ID))
trigger1 = TeamSide = 2
var(41) = floor(Abs(ifelse(Facing = 1,Helper(33100+ID),RootDist X,Helper(33000+ID),RootDist X)))
IgnoreHitPause = 1

[State -1, 当人物开局在左边时检测后方的距离]
Type = VarSet
trigger1 =(NumHelper(33000+ID) && NumHelper(33100+ID))
trigger1 = TeamSide = 1
var(42) = floor(Abs(ifelse(Facing = 1,Helper(33100+ID),RootDist X,Helper(33000+ID),RootDist X)))
IgnoreHitPause = 1

[State -1, 当人物是开局在右边时检测后方的距离]
Type = VarSet
trigger1 =(NumHelper(33000+ID) && NumHelper(33100+ID))
trigger1 = TeamSide = 2
var(42) = floor(Abs(ifelse(Facing = 1,Helper(33000+ID),RootDist X,Helper(33100+ID),RootDist X)))
IgnoreHitPause = 1

;------------------------------------------------------------------------------------------
;压起身
[State 压起身]
type = VarSet
triggerall = var(59)
triggerall = var(44) = 0
triggerall = roundstate = 2
triggerall = enemynear(var(58)),statetype = L && enemynear(var(58)),movetype != A
triggerall = enemynear(var(58)),ctrl = 0
triggerall = enemynear(var(58)),stateno != 5120 || enemynear(var(58)),animtime < -4
trigger1 = statetype != L && movetype != H
trigger1 = p2bodydist X <= 150
var(44) = 1 + (random % 4)

[State 压起身]
type = varset
triggerall = var(44) != 0
trigger1 = roundstate != 2 || movetype = H || movetype = A || statetype = L
var(44) = 0

[State 压起身]
type = varset
triggerall = var(44) != 0
trigger1 = var(44) = 1 && enemynear(var(58)),stateno = 5120
trigger1 = enemynear(var(58)),animtime = 0
trigger2 = var(44) = 2 && enemynear(var(58)),stateno = 5120
trigger2 = enemynear(var(58)),animtime > -6
trigger2 = !((stateno = [30,39]) || statetype = A)
trigger3 = var(44) = 3 && enemynear(var(58)),stateno = 5120
trigger3 = enemynear(var(58)),animtime > -5
trigger4 = var(44) = 4 && enemynear(var(58)),stateno = 5120
var(44) = 10

