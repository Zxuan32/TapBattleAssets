triggerall = var(59) >= 1
trigger1 = var(50) > 0
trigger1 = Enemynear(var(58)),movetype != H 
trigger2 = var(50) > 0
trigger2 = !Numtarget
trigger3 = var(50) < 0
v = 50
value = 0
