;-----------------------------------------------------------------------
; 对手的硬直时间计算
[State -3, VarSet]
Type = VarSet
trigger1 = var(49) != 0
V = 49
Value = 0
IgnoreHitPause = 1

[State -3, 敌人的硬直时间]
Type = VarSet
triggerall = !EnemyNear(var(58)),Ctrl
triggerall = EnemyNear(var(58)),StateType != A
triggerall = EnemyNear(var(58)),StateType != L
