;------------------------------------------------------------------------------
;连段限制
;------------------------------------------------------------------------------

[State 0, 连段限制AI1]
type = VarSet
trigger1 = var(59) = 1
v = 51
value = 10
ignorehitpause = 1
persistent = 1

[State 0, 连段限制AI2]
type = VarSet
trigger1 = var(59) = 2
v = 51
value = 15
ignorehitpause = 1
persistent = 1

[State 0, 连段限制AI3]
type = VarSet
trigger1 = var(59) = 3
v = 51
value = 20
ignorehitpause = 1
persistent = 1

;------------------------------------------------------------------------------
;超杀
;------------------------------------------------------------------------------

[State 0, 超能力组合曲]
type = ChangeState
value = 4000
triggerall = var(59) >= 1
triggerall = var(50) > var(51)
triggerall = var(50) < var(51)+3
triggerall = power >= 3000
triggerall = statetype != A
triggerall = Enemynear(var(58)),Alive
triggerall = (Enemynear(var(58)),statetype != L) || ((Enemynear(var(58)),statetype = L) && ((Enemynear(var(58)),stateno = [4935,4950])))
triggerall = ((Facing*(EnemyNear(var(58)),Pos x-Pos x)+floor(fvar(4)*20)) <= 200) || var(41) < 200
triggerall = p2bodydist y = [-90,0]
trigger1 = ctrl || (stateno = [10,12]) || (stateno = [20,22]) || (stateno = [100,101])
ignorehitpause = 0
persistent = 0

[State 0, 能量封锁]
type = ChangeState
value = 2100
triggerall = var(59) >= 1
triggerall = var(50) > var(51)
triggerall = var(50) < var(51)+3
triggerall = power >= 1000
triggerall = power < 4000
triggerall = random <= 500
triggerall = statetype != A
triggerall = Enemynear(var(58)),Alive
triggerall = (Enemynear(var(58)),statetype != L) || ((Enemynear(var(58)),statetype = L) && ((Enemynear(var(58)),stateno = [4935,4950])))
trigger1 = ctrl || (stateno = [10,12]) || (stateno = [20,22]) || (stateno = [100,101])
ignorehitpause = 0
persistent = 0

[State 0, MAX空间移动]
type = ChangeState
value = IfElse(statetype != A,2000,2050)
triggerall = var(59) >= 1
triggerall = var(50) > var(51)
triggerall = var(50) < var(51)+3
triggerall = power >= 1000
triggerall = power < 4000
triggerall = Enemynear(var(58)),Alive
triggerall = (Enemynear(var(58)),statetype != L) || ((Enemynear(var(58)),statetype = L) && ((Enemynear(var(58)),stateno = [4935,4950])))
triggerall = Enemynear(var(58)),Pos Y = [-40,0]
trigger1 = ctrl || (stateno = [10,12]) || (stateno = [20,22]) || (stateno = [100,101])
trigger2 = stateno = 620
trigger2 = movehit
ignorehitpause = 0
persistent = 0

;------------------------------------------------------------------------------
;结束连段
