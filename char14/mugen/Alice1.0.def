; 功夫人的中文化def文档。
; 由MKII翻译。
; 包括人物所需要的文件名。

; 人物信息
[Info]
name = "Alice"        ;人物名
displayname = "Alice" ;显示名
versiondate = 12,31,2020    ;人物版本号 (月-日-年 或者 X.XX)
mugenversion = 1.0          ;人物对应的MUGEN版本 (X.XX)
author = "TTL"         ;作者名
pal.defaults = 1,2,3,4      ;默认色表顺序 (最多4个)
                            ;序号从1开始
localcoord = 320,240        ;分辨率宽度和高度

; 人物文件
[Files]
cmd     = CMD/Alice.cmd           ;操作输入
cns     = CNS/Alice.cns           ;常量定义
st       = CNS/Alice.cns           ;State定义
stcommon = CNS/Alice_C.cns        ;公用state (人物文件夹或者common文件夹中)
st2     = CNS/Alice_N.cns
st3     = CNS/Alice_S.cns
st4     = CNS/Alice_H.cns
st5     = CNS/Alice_1.0Helper.cns
st6     = CNS/Alice_AI_Helper.cns
st7     = CNS/Alice_-2.cns
st8     = CNS/Alice_-3.cns
st9     = Option/Alice_Option.cns
sprite  = SFF/Alice.sff           ;图像文件
anim    = AIR/Alice.air           ;动作文件
sound   = SND/Alice.snd           ;声效文件

; 将选人时的按键对应到色表上
[Palette Keymap]
x = 1 ;按X按键选色表1，以此类推
y = 2
z = 3
a = 4
b = 5
c = 6
;x2 = 7 ;按start和X按键选色表7，以此类推
;y2 = 8
;z2 = 9
;a2 = 10
;b2 = 11
;c2 = 12

; arcade模式的开头结局动画
[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
