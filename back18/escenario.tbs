// buu1: escenario de MUGEN convertido con mugen_stage.py y
// hecho vuelta con stage_loop.py (cada capa, su tramo y su espejo).
// Seccion 37 de docs/MODDING.md.
stage {
    width = 1280;
    in_order;              // el piso tapa el pie de las salpicaduras
    layer ground {
        place "00.png" at -78, -119;
        place "00.png" at 562, -119 mirror;
        place "01.png" at -78, -113;
        place "01.png" at 562, -113;
    }
    chase {
        background "02.png" at 0, -119 sky 200;
    }
}
