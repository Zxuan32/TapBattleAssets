        link ano_101 { flag = 4; }
        frame { sprite = sprite_10; origin = -50, -74; }
    }

    ano_11 {
        frame {
            time = 1; sprite = sprite_0; origin = -25, -37;
            render { rotate = 0; alpha = 0; zoom = 50, 50; }
