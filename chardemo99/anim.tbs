animation {
    // Animaciones del personaje. Cada bloque 'ano_N' es la animacion
    // que el motor pide con ese numero; 'ano_M = ano_N;' es un alias,
    // los dos numeros comparten la misma animacion.
    //
    // Regla del lenguaje: 'clave = valor;' es un dato, una palabra
    // suelta es un flag, y una declaracion con argumentos ('hurtbox
    // at ... size ...') declara algo que el frame contiene.
    //
    // Los flags del binario NO se escriben: se deducen de los campos
    // presentes. Quita 'sound = 80;' y el bit se apaga solo, asi que
    // no hay forma de dejarlos descuadrados.
    //
    // 'link' es otra animacion que corre A LA VEZ que esta (los rayos
    // de Vegito, por ejemplo). Con flag 12 va muy lenta y con 4 al
    // ritmo normal. Son por ano: hay que repetirlos en cada uno.
    //
    // Cajas de un frame: 'hurtbox' la del personaje, 'hitbox' la de
    // ataque, 'spawn ano_N' lanza el ano N (201-255), y ademas
    // 'blackscreen', 'shake N', 'charf N', 'collision'.
    //
    // Flags del frame (lo que hacen en el motor):
    //   loop        al acabar vuelve al primer frame de este ano
    //   flip_x/_y   espeja las cajas en X / en Y
    //   keep_speed  conserva la velocidad del frame anterior; sin el,
    //               la velocidad se pone a cero
    //
    // El bloque 'options':
    //   effect = N  que polvo levanta (1-15)
    //   cancel      deja seguir pulsando / disparar mas balas
    //   wall        el golpe va contra la pared
    //   power = N   potencia del dano
    //   damage = N  indice de dano (tablas 14-33 del bin)
    //   tween       interpola giro, alfa y zoom hasta el frame que viene
    //
    // 'padding' son bytes cero detras del ultimo frame. El motor pide
    // una animacion en base + indice*4, asi que todas empiezan en un
    // multiplo de 4; el original redondeaba el bloque entero a esa
    // rejilla y esos bytes son lo que sobra. Nadie los lee: se
    // conservan solo para que un .pac sin tocar salga identico, y
    // cambiarlos no rompe nada.

    anos  = 344;   // tamano de la tabla: no hay anos por encima de este

    ano_0 {
        frame { sprite = sprite_0; origin = -25, -62; }
    }

    ano_1 {
        frame { sprite = sprite_1; origin = -25, -62; }
    }

    ano_2 {
        frame { sprite = sprite_2; origin = -25, -62; }
    }

    ano_3 {
        frame { sprite = sprite_3; origin = -25, -62; }
    }

    ano_4 {
        frame { sprite = sprite_4; origin = -25, -62; }
    }

    ano_5 {
        frame { sprite = sprite_5; origin = -25, -62; }
    }

    ano_6 {
        frame { sprite = sprite_6; origin = -25, -62; }
    }

    ano_7 {
        frame { sprite = sprite_7; origin = -25, -62; }
    }

    ano_8 {
        frame { sprite = sprite_8; origin = -25, -62; }
    }

    ano_9 {
        frame { sprite = sprite_9; origin = -25, -62; }
    }

    ano_10 {
        frame { sprite = sprite_10; origin = -25, -62; }
    }

    ano_11 {
        frame { sprite = sprite_11; origin = -25, -62; }
    }

    ano_12 {
        frame { sprite = sprite_12; origin = -25, -62; }
    }

    ano_13 {
        frame { sprite = sprite_13; origin = -25, -62; }
    }

    ano_98 {
        frame { sprite = sprite_14; origin = -25, -62; }
    }

    ano_99 {
        frame { sprite = sprite_15; origin = -23, -46; }
    }

    ano_97 {
        frame { sprite = sprite_16; origin = -123, -64; }
    }

    ano_90 {
        frame { sprite = sprite_17; origin = -120, -34; }
    }

    ano_91 {
        frame { sprite = sprite_18; origin = -12, -24; }
    }

    ano_92 {
        frame { sprite = sprite_19; origin = -12, -24; }
    }

    ano_220 {
        frame { sprite = sprite_20; origin = -40, -72; }
    }

    ano_221 {
        frame { sprite = sprite_21; origin = -40, -72; }
    }

    ano_222 {
        frame { sprite = sprite_22; origin = -80, -32; }
    }

    ano_223 {
        frame { sprite = sprite_23; origin = -236, -40; }
    }

    ano_224 {
        frame { sprite = sprite_24; origin = -17, -28; }
    }

    ano_225 {
        frame { time = 20; sprite = sprite_25; origin = -10, -30; }
        frame { time = 14; sprite = -1; origin = -10, -30; loop; }
    }

    ano_226 {
        frame {
            time = 30; sprite = sprite_26; origin = 6, -6;
            render { rotate = 0; alpha = 256; zoom = 100, 180; }
            options { tween; }
        }
        frame {
            time = 30; sprite = sprite_26; origin = 6, -6;
            render { rotate = 0; alpha = 511; zoom = 100, 180; }
            options { tween; }
        }
        frame {
            time = 1; sprite = sprite_26; origin = 6, -6; loop;
            render { rotate = 0; alpha = 256; zoom = 100, 180; }
        }
    }

    ano_227 {
        frame { sprite = sprite_27; origin = -106, -32; }
    }

    ano_228 {
        frame { sprite = sprite_28; origin = -106, -32; }
    }

    ano_229 {
        frame { sprite = sprite_29; origin = -118, -32; }
    }

    ano_230 {
        frame { sprite = sprite_30; origin = -118, -32; }
    }

    ano_231 {
        frame { sprite = sprite_31; origin = -118, -32; }
    }

    ano_232 {
        frame { sprite = sprite_32; origin = -118, -32; }
    }

    ano_103 {
        frame { sprite = sprite_33; origin = -78, -22; }
    }

    ano_104 {
        frame { sprite = sprite_34; origin = -78, -22; }
    }

    ano_105 {
        frame { sprite = sprite_35; origin = -78, -22; }
    }

    ano_106 {
        frame { sprite = sprite_36; origin = -78, -22; }
    }

    ano_107 {
        frame { sprite = sprite_37; origin = -78, -22; }
    }

    ano_114 {
        frame { sprite = sprite_38; origin = -78, -22; }
    }

    ano_115 {
        frame { sprite = sprite_39; origin = -78, -22; }
    }
}
