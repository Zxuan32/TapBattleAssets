package "char10.pac" {
    // Contenido del .pac, EN ORDEN: asi lo lee GameData.Init y el
    // orden es significativo. El numero de 'image' es la hoja que
    // nombra 'sheet' en sprites.tbs, y el de 'sound' la voz que pide
    // 'sound = N' en animation.tbs. Mover una entrada renumera todas
    // las de su tipo, asi que se anade al final ('extract.py adopt').
    //
    // Una voz N se pide desde un frame con 'sound = 80 + N':
    // TCBManajer1 /*00DC1*/ hace playAudio(no - 80); por debajo de 80
    // /*00DBD*/ es un se_NN.ogg suelto, no una voz del personaje.
    //
    // 'extra' son 4 bytes que el juego NO LEE: GameData.Init saca de
    // cada entrada el offset (pos+0..3), el tamano (pos+4..7) y el
    // tipo (pos+8..11), y a decodeData solo le pasa esos tres; los
    // pos+12..15 no los toca nadie. Tampoco son checksum: hay tres
    // wav de contenido identico con tres 'extra' distintos. Se
    // conservan tal cual solo para que el .pac salga identico; en una
    // entrada nueva se deja sin poner y ya.

    image   "png00.png"   extra = 0x242aa400;   // hoja 0
    image   "png01.png"   extra = 0xbf5d1700;   // hoja 1
    image   "png02.png"   extra = 0x65452e00;   // hoja 2
    image   "png03.png"   extra = 0xa382f700;   // hoja 3
    image   "png04.png"   extra = 0x60c2f600;   // hoja 4
    image   "png05.png"   extra = 0xce651d00;   // hoja 5
    image   "png06.png"   extra = 0xc77b7900;   // hoja 6
    image   "png07.png"   extra = 0xdf798300;   // hoja 7
    image   "png08.png"   extra = 0xe5246d00;   // hoja 8
    image   "png09.png"   extra = 0xd527ac00;   // hoja 9
    image   "png10.png"   extra = 0x17b04500;   // hoja 10
    image   "png11.png"   extra = 0x72bffa00;   // hoja 11
    image   "png12.png"   extra = 0x31d51200;   // hoja 12
    image   "png13.png"   extra = 0x789da900;   // hoja 13
    image   "png14.png"   extra = 0x80514700;   // hoja 14
    image   "png15.png"   extra = 0x2c501900;   // hoja 15
    tables  "tables.tbs"  extra = 0x68f5b900;
    sprites "sprites.tbs" extra = 0x158a4200;
    anim    "anim.tbs"    extra = 0x9bded300;
    sound   "wav00.wav"   extra = 0xa2cda600;   // 22050 Hz, 16 bit, mono, 1.02 s
    sound   "wav01.wav"   extra = 0x87f13800;   // 22050 Hz, 16 bit, mono, 1.34 s
    sound   "wav02.wav"   extra = 0x3528aa00;   // 22050 Hz, 16 bit, mono, 1.42 s
    sound   "wav03.wav"   extra = 0x96789c00;   // 22050 Hz, 16 bit, mono, 1.12 s
    sound   "wav04.wav"   extra = 0x1ccdf000;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav05.wav"   extra = 0x62c5a700;   // 22050 Hz, 16 bit, mono, 1.27 s
    sound   "wav06.wav"   extra = 0x91cd2500;   // 22050 Hz, 16 bit, mono, 1.19 s
    sound   "wav07.wav"   extra = 0xd39b2b00;   // 22050 Hz, 16 bit, mono, 0.99 s
    sound   "wav08.wav"   extra = 0x86fcdf00;   // 22050 Hz, 16 bit, mono, 0.97 s
    sound   "wav09.wav"   extra = 0x84faeb00;   // 22050 Hz, 16 bit, mono, 1.36 s
    sound   "wav10.wav"   extra = 0x64be8600;   // 22050 Hz, 16 bit, mono, 1.41 s
    sound   "wav11.wav"   extra = 0xabd2c700;   // 22050 Hz, 16 bit, mono, 2.04 s
    sound   "wav12.wav"   extra = 0xa6de1e00;   // 22050 Hz, 16 bit, mono, 1.95 s
    sound   "wav13.wav"   extra = 0x74bd6d00;   // 22050 Hz, 16 bit, mono, 1.14 s
    sound   "wav14.wav"   extra = 0xfbddc200;   // 22050 Hz, 16 bit, mono, 1.49 s
    info    "info.tbs";
}
