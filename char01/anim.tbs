        frame { time = 1; sprite = sprite_50; origin = -29, -46; }
        frame { time = 8; sprite = sprite_53; origin = -29, -44; }
        frame { time = 10; sprite = sprite_52; origin = -30, -44; }
        frame { time = 8; sprite = sprite_53; origin = -29, -44; }
        frame { time = 10; sprite = sprite_50; origin = -29, -46; loop; }
    }
}
