;---------------------------------------------------------------------------
;超能力球
[Statedef 1000]
type    = S                      ;状态: S-站立, C-蹲, A-空中, L-倒地
movetype= A                      ;招式种类: A-攻击, I-非攻击, H-受击
physics = S                      ;物理: S-站立, C-蹲, A-空中
;常用的控制器:
velset = 0,0                     ;设定速度 (x,y) (不写这行则不改变速度)
ctrl = 0                         ;设定可控与否 (不写这行则不改变ctrl)
anim = 1000                       ;改变动作 (不写这行则不改变anim)
sprpriority = 3                  ;设定p1的贴图优先度到2 (在前面)

;---------------------------------------------------------------------------
;攻击判定

[State 1000]
type = Projectile ;攻击类型
trigger1 = time = 15
projID = 1000 ;飞道ID号
projanim = 1005 ;飞道动画
projhitanim = 1006 ;击中时的动画
projremanim = 1006 ;销毁时的动画
projremove = 1 ;击中后是否消失
projremovetime = -1 ;飞道持续多久后消失
projedgebound = 6
velocity = 6,0;6,0 ;飞道的初速度
accel = 0,0
projpriority = 43967777777 ;优先级
projsprpriority = 5 ;图像优先级
projshadow = 0,0,0 ;影子颜色
offset = 20,0 ;飞道发射的位置
getpower = 100,100
givepower = 50,0
attr = S, SP
animtype = Hard
damage = 30,15
hitflag = MAF
guardflag = MA
hitsound = s400,1
guardsound = s100,9
pausetime = 0,12
guard.pausetime = 0,12
sparkno = -1
guard.sparkno = -1
sparkxy = 10,-55
ground.type = High
ground.hittime = 20
guard.ctrltime = 20
ground.slidetime = 5
ground.velocity = -5
air.velocity = -3.6,-3.8
air.fall = 1

;---------------------------------------------------------------------------
;音效

[State 0, 人物音效]
type = PlaySnd
trigger1 = time = 1
value = s1,0

[State 0, 发射音效]
type = PlaySnd
trigger1 = time = 14
value = s8,3

;---------------------------------------------------------------------------
;继续攻击

[State 1000, 2]
type = ChangeState
triggerall = var(59) = 0
trigger1 = time >= 22
trigger1 = command = "a"
value = 1020
ctrl = 0

;---------------------------------------------------------------------------
;状态转出
[State 1000, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;超能力球p2
[statedef 1002, 超能力球p2]
type    = S
movetype= H
physics = S
poweradd = 0
VelSet = 0,0
ctrl = 0
sprpriority = -2
facep2 = 1

;---------------------------------------------------------------------------
;helper销毁
[State 0, DestroySelf]
type = DestroySelf
trigger1 = ishelper
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;动画改变
[state 0]
type = changeAnim2
Trigger1 = time = 0
value = 1002

;---------------------------------------------------------------------------
;速度设置
[State 0, VelSet]
type = VelSet
trigger1 = time = [12,20]
x = -5
y = 0
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;状态转出
[State 0, selfState]
type = selfState
trigger1 = time >= 35
value = 0
ctrl = 1

