[State 0, 允许出屏]
type = ScreenBound
trigger1 = time = [6,8]
value = 0
movecamera = 0,0
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;瞬移
[state 0, 瞬移]
type = posadd
trigger1 = time = 7
x = ((enemynear,pos X)-pos X)*facing + 55
y = ((enemynear,pos Y)-pos Y) + 0

;---------------------------------------------------------------------------
;转向
[State 0, Turn]
type = Turn
trigger1 = time = 8
trigger1 = ((enemynear,pos X)-pos X)*facing < 0
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;攻击判定
[State 1120,1]
type = HitDef
trigger1 = AnimElem = 4
attr = S, NA                     ;Hitdef属性： 站立，普通攻击
damage = 0, 0                   ;招式造成的伤害, 防御伤害
getpower = 100,100
givepower = 50,0
animtype = Heavy                 ;动作种类: Light-轻, Medium-中, Heavy-重, Back-后仰 (默认: Light)
guardflag = HA                   ;能被什么状态的敌人防御
hitflag = MAF                    ;能击中什么状态的敌人
priority = 7, Hit                ;攻击优先度: 0 (最低) to 7 (最高), 4 默认，相杀式的处理：Hit-可以击中非dodge情况的敌方/Miss-我方攻击一定miss/Dodge-一定躲避敌方攻击 (默认: Hit)
pausetime = 20, 10                 ;攻击者暂停的时间, 对手在hitshake的时间
sparkno = -1                      ;火花的动作号 (默认: 在上面设置的动作好)
sparkxy = -8, -75               ;火花相对于p2的X坐标偏移量，火花相对于p1的Y坐标偏移量
guard.sparkno = -1
hitsound = S400,4                  ;击中时播放的音效
guardsound = S100, 9                ;被防御时播放的音效
ground.type = High               ;种类: High-上段, Low-下段, Trip-绊倒 (默认: Normal)
ground.slidetime = 4             ;对方向后滑的时间
ground.hittime  = 25             ;对方在被击中状态的时间
guard.ctrltime  = 25             ;对方在防御状态的时间
ground.velocity = -2             ;对方被向后推的速度
airguard.velocity = -1.9,-.8     ;空中防御的速度 (默认: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;空中击中的种类: High-上段, Low-下段, Trip-绊倒 (默认: 和ground.type一样)
air.velocity = -1,-3           ;空中击中时对方被向后推的横向速度, 空中击中时对方被向后推的纵向速度
air.hittime = 24                 ;空中击中对方在被击中状态的时间、
envshake.ampl = 12
envshake.freq = 40
envshake.time = 20
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
down.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
ID = 1120

;---------------------------------------------------------------------------
;敌方状态控制

[State 0, 击飞]
type = TargetState
triggerall = NumTarget
trigger1 = movehit = 1
value = 1125
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;固伤

[State 0, 固伤扣血]
type = TargetLifeAdd
triggerall = Numtarget
trigger1 = movehit = 1
value = -(fvar(10)*0.05)
ID = -1
kill = 1
absolute = 1
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;打击火花与防御火花
[State 0, 打击火花]
type = Explod
trigger1 = movehit = 1
anim = 6002
pos = facing*(Enemynear,Pos X - Pos X),-82
postype = p1
facing = 1
bindtime = 1
vel = 0,0
removetime = -2
pausemovetime = 999999
supermovetime = 999999
scale = 0.8,0.8
sprpriority = 999
ontop = 1
ownpal = 1
ignorehitpause = 1
persistent = 0

[State 0, 防御火花]
type = Explod
trigger1 = MoveGuarded = 1
anim = 6003
pos = facing*(Enemynear,Pos X - Pos X),-82
postype = p1
facing = -1
bindtime = 1
vel = 0,0
removetime = -2
pausemovetime = 999999
supermovetime = 999999
scale = 1.2,1.2
sprpriority = 999
ontop = 1
ownpal = 1
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;音效

[State 1120, 2]
type = PlaySnd
trigger1 = time = 14
value = s0, 6

[State 1120, 挥动音效]
type = PlaySnd
trigger1 = animelem = 3
value = s4, 1

;---------------------------------------------------------------------------
;状态转出
[State 1120, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


;---------------------------------------------------------------------------
;空中受击
[statedef 1125, 空中受击]
type    = A
movetype= H
physics = N
poweradd = 0
VelSet = 0,0
ctrl = 0
sprpriority = -2
facep2 = 1

;---------------------------------------------------------------------------
;helper销毁
[State 0, DestroySelf]
type = DestroySelf
trigger1 = ishelper
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;动画改变
[state 0]
type = changeAnim2
Trigger1 = time = 0
value = 206

;---------------------------------------------------------------------------
;速度设置
[State 0, VelSet]
type = VelSet
trigger1 = time = 16
x = -5
y = -8
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;状态转出
[State 0, ChangeState]
type = ChangeState
trigger1 = time >= 24
value = 1126
ctrl = 0

[statedef 1126, 空中p2（下落）]
type    = A
movetype= H
physics = N
poweradd = 0
ctrl = 0
sprpriority = -2

;---------------------------------------------------------------------------
;动画改变
[state 0]
type = changeAnim2
Trigger1 = time = 0
value = 207

;---------------------------------------------------------------------------
;速度设置

[State 0, VelAdd]
type = VelAdd
trigger1 = Vel Y < 8
y = 0.6
ignorehitpause = 1
persistent = 1

[State 0, 速度修正]
type = VelSet
trigger1 = Vel Y >= 8
y = 8
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;状态转出
[State 0, ChangeState]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 4935 ;Hit ground
ctrl = 0

;---------------------------------------------------------------------------
;混合连打(Y型)
[Statedef 1150]
type    = S                      ;状态: S-站立, C-蹲, A-空中, L-倒地
movetype= A                      ;招式种类: A-攻击, I-非攻击, H-受击
physics = S                      ;物理: S-站立, C-蹲, A-空中
;常用的控制器:
velset = 0,0                     ;设定速度 (x,y) (不写这行则不改变速度)
ctrl = 0                         ;设定可控与否 (不写这行则不改变ctrl)
anim = 1150                       ;改变动作 (不写这行则不改变anim)
sprpriority = 3                  ;设定p1的贴图优先度到2 (在前面)

;---------------------------------------------------------------------------
;宽度调整
[State 0, Width]
type = Width
trigger1 = 1
edge = 30,0
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;速度
[State 0, VelSet]
type = VelSet
trigger1 = time = [7,15]
x = 3
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;攻击判定
[State 1100,1]
type = HitDef
trigger1 = AnimElem = 4
attr = S, NA                     ;Hitdef属性： 站立，普通攻击
damage = 40, 0                   ;招式造成的伤害, 防御伤害
getpower = 80,80
givepower = 30,0
animtype = Medium                 ;动作种类: Light-轻, Medium-中, Heavy-重, Back-后仰 (默认: Light)
guardflag = HA                   ;能被什么状态的敌人防御
hitflag = MAF                    ;能击中什么状态的敌人
priority = 5, Hit                ;攻击优先度: 0 (最低) to 7 (最高), 4 默认，相杀式的处理：Hit-可以击中非dodge情况的敌方/Miss-我方攻击一定miss/Dodge-一定躲避敌方攻击 (默认: Hit)
pausetime = 0, 0                 ;攻击者暂停的时间, 对手在hitshake的时间
guard.pausetime = 8, 8         ;攻击被防御后暂停的时间
sparkno = -1                      ;火花的动作号 (默认: 在上面设置的动作好)
sparkxy = -8, -75               ;火花相对于p2的X坐标偏移量，火花相对于p1的Y坐标偏移量
guard.sparkno = -1
hitsound = S400, 3                  ;击中时播放的音效
guardsound = S100, 9                ;被防御时播放的音效
ground.type = High               ;种类: High-上段, Low-下段, Trip-绊倒 (默认: Normal)
ground.slidetime = 4             ;对方向后滑的时间
ground.hittime = 20             ;对方在被击中状态的时间
guard.ctrltime = 20             ;对方在防御状态的时间
ground.velocity = -2             ;对方被向后推的速度
airguard.velocity = -1.9,-.8     ;空中防御的速度 (默认: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;空中击中的种类: High-上段, Low-下段, Trip-绊倒 (默认: 和ground.type一样)
air.velocity = -1,-3           ;空中击中时对方被向后推的横向速度, 空中击中时对方被向后推的纵向速度
air.hittime = 20                 ;空中击中对方在被击中状态的时间、
envshake.ampl = 6
envshake.freq = 45
envshake.time = 12
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
down.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
