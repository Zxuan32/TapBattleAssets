trigger1 = 1
edge = 30,0
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;速度
[State 0, VelSet]
type = VelSet
trigger1 = time = [4,12]
x = 3
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;攻击判定
[State 1100,1]
type = HitDef
trigger1 = AnimElem = 4
attr = S, NA                     ;Hitdef属性： 站立，普通攻击
damage = 40, 0                   ;招式造成的伤害, 防御伤害
getpower = 80,80
givepower = 30,0
animtype = Medium                 ;动作种类: Light-轻, Medium-中, Heavy-重, Back-后仰 (默认: Light)
guardflag = HA                   ;能被什么状态的敌人防御
hitflag = MAF                    ;能击中什么状态的敌人
priority = 5, Hit                ;攻击优先度: 0 (最低) to 7 (最高), 4 默认，相杀式的处理：Hit-可以击中非dodge情况的敌方/Miss-我方攻击一定miss/Dodge-一定躲避敌方攻击 (默认: Hit)
pausetime = 0, 0                 ;攻击者暂停的时间, 对手在hitshake的时间
guard.pausetime = 8, 8         ;攻击被防御后暂停的时间
sparkno = -1                      ;火花的动作号 (默认: 在上面设置的动作好)
sparkxy = -8, -75               ;火花相对于p2的X坐标偏移量，火花相对于p1的Y坐标偏移量
guard.sparkno = -1
hitsound = S400, 3                  ;击中时播放的音效
guardsound = S100, 9                ;被防御时播放的音效
ground.type = High               ;种类: High-上段, Low-下段, Trip-绊倒 (默认: Normal)
ground.slidetime = 4             ;对方向后滑的时间
ground.hittime = 20             ;对方在被击中状态的时间
guard.ctrltime = 20             ;对方在防御状态的时间
ground.velocity = -2             ;对方被向后推的速度
airguard.velocity = -1.9,-.8     ;空中防御的速度 (默认: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;空中击中的种类: High-上段, Low-下段, Trip-绊倒 (默认: 和ground.type一样)
air.velocity = -1,-3           ;空中击中时对方被向后推的横向速度, 空中击中时对方被向后推的纵向速度
air.hittime = 20                 ;空中击中对方在被击中状态的时间、
envshake.ampl = 6
envshake.freq = 45
envshake.time = 12
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
down.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
ID = 1100

