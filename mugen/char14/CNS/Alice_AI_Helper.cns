Trigger1 = 1
value = 0

[state 20000]
type = Projectile
Trigger1 = time = 0
velocity = 10,0
projID = 20000
projanim = 0
offset = 0,100000
projstagebound = 0
Projedgebound = 100000
Projremovetime = -1

[state 20000]
type = velset
Trigger1 = Root,NumProjID(20000) = 0
Trigger1 = time > 0
x = 0
y = 0

