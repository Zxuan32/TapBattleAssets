;===============================================================================
;Guard I
[statedef 998]
ctrl = 0
anim = 9999

[State 0, BindToRoot]
type = BindToRoot
trigger1 = 1
time = 1
pos = 50,0
ignorehitpause = 1

[State 999]
type = nothitby
trigger1 = 1
value = sca

[State 999]
type = selfstate
trigger1 = !ishelper
value = 0

[State 999, AssertSpecial]
type = AssertSpecial
Trigger1 = 1
flag = NoShadow
flag2 = invisible

[State 999, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 0
;================================================
[State 0, VarSet]
type = VarSet
trigger1 =!var(1)
v = 1
value = enemynear(0),id
ignorehitpause = 1

[State 0, VarSet]
type = VarSet
triggerall = numenemy = 2
trigger1 = var(1)
trigger1 =!var(2)
v = 2
value = enemynear(1),id
ignorehitpause = 1
;================================================
[State 33500]
type = Null
triggerall = roundstate = 2
trigger1 = 1||var(19):= var(18)
trigger1 = 1||var(18):= var(17)
trigger1 = 1||var(17):= var(16)
trigger1 = 1||var(16):= var(15)
trigger1 = 1||var(15):= var(14)
trigger1 = 1||var(14):= var(13)
trigger1 = 1||var(13):= var(12)
trigger1 = 1||var(12):= var(11)
trigger1 = 1||var(11):= var(10)
trigger1 = 1||var(10):= playerid(var(1)),stateno
ignorehitpause = 1
;================================================
[State 33500]
type = VarAdd
trigger1 = Root,NumHelper(33501)
trigger2 = var(3)
v = 3
value = 1
ignorehitpause = 1

[State 33500]
type = VarSet
trigger1 = var(3) > 30
v = 3
value = 0
ignorehitpause = 1
;================================================
[State 33500]
type = VarAdd
Trigger1 = var(3) = 1
fv = 0
value = 1
ignorehitpause = 1
;================================================
[State 33500]
type = VarSet
triggerall = fvar(0) = 0
trigger1 = parent,var(43) < 0
fv = 0
value = -parent,var(43)
ignorehitpause = 1

[State 33500]
type = ParentVarSet
triggerall = fvar(0) = [0,2]
trigger1 = parent,var(43) + fvar(0) != 0
v = 43
value = -fvar(0)
ignorehitpause = 1

[State 33500]
type = ParentVarSet
triggerall = fvar(0) > 2
triggerall = parent,fvar(9+fvar(0)) = 0
trigger1 = parent,life <= parent,lifemax*.5 && roundno = 1
trigger2 = parent,life <= parent,lifemax*.75 && roundno > 1
trigger3 = roundno > 2
v = 43
value = -fvar(0)
ignorehitpause = 1

[State 33500]
type = ParentVarSet
triggerall = fvar(0) > 3
trigger1 = parent,fvar(9+fvar(0)) = 0
trigger2 = fvar(0) > 4
v = 43
value = -fvar(0)
ignorehitpause = 1
