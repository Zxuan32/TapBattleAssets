;Guard II
;-----------------------------------------------------------------------
[statedef 999]
ctrl = 0
anim = 9999

[State 0, BindToRoot]
type = BindToRoot
trigger1 = 1
time = 1
pos = -50,0
ignorehitpause = 1

[State 999]
type = nothitby
trigger1 = 1
value = sca

[State 999]
type = selfstate
trigger1 = !ishelper
value = 0

[State 999, AssertSpecial]
type = AssertSpecial
Trigger1 = 1
flag = NoShadow
flag2 = invisible

[State 999, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 0

[State -2, Debug]
type = DisplayToClipboard
trigger1 = 1
text = "v1=%d,v2=%d,v3=%d,v4=%d,v5=%d,v0=%d\n"
params = var(1),var(2),var(3),var(4),var(5),var(0)
ignorehitpause = 1

[State -2, Debug]
type = AppendToClipboard
trigger1 = 1
text = "v11=%d,v12=%d,v13=%d,v14=%d,v15=%d,v16=%d"
params = var(11),var(12),var(13),var(14),var(15),var(16)
ignorehitpause = 1
