; 功夫人的中文化cns文档。
; 由MKII翻译。

; 这篇文章里有很多注释，对cns的学习有一定的参考作用
;
; 注意：
; p1指玩家，p2指敌人
; y坐标（纵向）里，负数指向上，正数指向下，0为地平线
; 不区分大小写

[Data]
;起始HP
life = 1000

;攻击力（数值高更强）
attack = 100

;防御力（数值高更强）
defence = 100

;倒地时增加防御力百分比
fall.defence_up = 50

;倒地后爬起需要的时间
liedown.time = 60

;Juggle点数
airjuggle = 100

;默认的打击火花号
sparkno = 2

;默认的防御火花号
guard.sparkno = 40

;设为1的话KO时会有回音
KO.echo = 0

;音量调节 (负数声音减小)
volumescale = 100

;能量上限（1000为一管）
power = 7000

;变量号大于以下数值的变量在局与局之间不会被清零。整数变量一共有60个，变量号为0至59。
;此外还有40个浮点变量，变量号为0至39.如果不写以下两行，那么所有的变量都会被清零。
;另外，你需要改变common1.cns里的state 5900来决定每一场之间清零与否。
IntPersistIndex = 0
FloatPersistIndex = 0

[Size]
xscale = 1           ;横向缩放比例
yscale = 1           ;纵向缩放比例
ground.back = 16     ;人物宽度 (地面上，中心到后方距离)
ground.front = 17    ;人物宽度 (地面上，中心到前方距离)
air.back = 13        ;人物宽度 (空中，中心到后方距离)
air.front = 12       ;人物宽度 (空中，中心到前方距离)
height = 60          ;人物高度(对手需要跳多高才能跳过)
attack.dist = 160    ;默认攻击距离
proj.attack.dist = 90 ;默认飞行道具攻击距离
proj.doscale = 0     ;如果值为1，则缩放飞行道具
head.pos = -15, -84   ;头部的大概位置
mid.pos = -18, -55    ;身体中部的大概位置
shadowoffset = 0     ;人物阴影的纵向偏移量
draw.offset = 0,0    ;人物图像的纵向偏移量 (x, y). 推荐 0,0

[Velocity]
walk.fwd  = 2      ;前进速度
walk.back = -2     ;后退速度
run.fwd  = 8, 0    ;跑步速度 (x, y)
run.back = -5,0 ;后跃速度 (x, y)
jump.neu = 0,-7.5    ;跳速度 (x, y)
jump.back = -3.5    ;后跳速度 (x, y)
jump.fwd = 3.5      ;前跳速度 (x, y)
runjump.back = -5,-8 ;跑跳速度 (可选)
runjump.fwd = 5,-8      ;.
airjump.neu = 0,-8      ;.
airjump.back = -2.55      ;二段跳速度 (可选)
airjump.fwd = 2.5         ;.
air.gethit.groundrecover = -.15,-3.5  ;地面受身速度 (x, y) **MUGEN 1.0专用**
air.gethit.airrecover.mul = .5,.2     ;空中受身速度系数 (x, y) **MUGEN 1.0专用**
air.gethit.airrecover.add = 0,-4.5    ;空中受身速度偏移 (x, y) **MUGEN 1.0专用**
air.gethit.airrecover.back = -1       ;按后按键时空中受身速度增加量 **MUGEN 1.0专用**
air.gethit.airrecover.fwd = 0         ;按前按键时空中受身速度增加量 **MUGEN 1.0专用**
air.gethit.airrecover.up = -2         ;按上按键时空中受身速度增加量 **MUGEN 1.0专用**
air.gethit.airrecover.down = 1.5      ;按下按键时空中受身速度增加量 **MUGEN 1.0专用**

[Movement]
airjump.num = 0       ;空中跳跃次数 (可选)
airjump.height = 35   ;空中跳跃时离地最小距离 (可选)
yaccel = .4          ;重力加速度
stand.friction = .5  ;站立时摩擦系数
crouch.friction = .5 ;下蹲时摩擦系数
stand.friction.threshold = 2          ;如果人物站立时速度小于这个数值，停止人物移动 **MUGEN 1.0专用**
crouch.friction.threshold = .05       ;如果人物下蹲时速度小于这个数值，停止人物移动 **MUGEN 1.0专用**
air.gethit.groundlevel = 25           ;当人物的Y坐标大于这个数值时，人物落地 **MUGEN 1.0专用**
air.gethit.groundrecover.ground.threshold = -20 ;当人物的Y坐标小于这个数值时，人物可以受身 **MUGEN 1.0专用**
air.gethit.groundrecover.groundlevel = 10   ;当人物的Y坐标小于这个数值时，人物可以受身落地 **MUGEN 1.0专用**
air.gethit.airrecover.threshold = -1  ;当人物的纵向速度大于这个数值时，人物可以受身 **MUGEN 1.0专用**
air.gethit.airrecover.yaccel = .35    ;人物受身时重力加速度 **MUGEN 1.0专用**
air.gethit.trip.groundlevel = 15      ;当人物在被绊倒的state里，Y坐标大于这个数值时，人物落地 **MUGEN 1.0专用**
down.bounce.offset = 0, 20            ;人物弹地时的坐标偏移量 (x, y) **MUGEN 1.0专用**
down.bounce.yaccel = .4               ;人物弹地时的重力加速度 **MUGEN 1.0专用**
down.bounce.groundlevel = 12          ;在人物弹地时，当人物的Y坐标大于这个数值时，人物落地 **MUGEN 1.0专用**
down.friction.threshold = .05         ;如果人物倒地时速度小于这个数值，停止人物移动 **MUGEN 1.0专用**

;默认语言下的胜利台词 (optional)  **MUGEN 1.0专用**
;如果包括这一段，默认语言必须为英语
[Quotes]
; 每种语言最多可以有100个胜利台词 (victory0 - victory99)
victory1 = "......"

;其他语言的胜利台词 (optional)
;可以不加入其他语言的胜利台词，也可以加入任意多个
;标识符开头必须用ISO 639-1标准来标识语(中文的标识符为zh)，例如 "[zh.Quotes]".
;在mugen.cfg里调整语言选项
[zh.Quotes]
victory1 = "......"

;---------------------------------------------------------------------------
; 变量表:
; 这是功夫人用的变量列表。
; 记录下你用的变量可以减少你的工作量。
; var(1)  - 在kfm.cmd里使用，检测可否取消 (每帧更新)
; var(2)  - 在功夫投里使用 (state 800)，记录是否按了前按键
;           (从state 800到state 810都有使用).


;---------------------------------------------------------------------------
; 时间到判负
; CNS难度：基本
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170]
type = PlaySnd
trigger1 = AnimElem = 1
value = s3,4

[State 170]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; 胜利后姿势判定
; CNS难度：基本
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = 181

;---------------------------------------------------------------------------
; 胜利姿势1-鞠躬
; CNS难度：基本
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181]
type = PlaySnd
trigger1 = AnimElem = 3
value = s3,0

[State 181]
type = AssertSpecial
trigger1 = Time = [0,100]
flag = RoundNotOver

[State 181]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; 开局之前
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

;---------------------------------------------------------------------------
;开场断言
[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = intro
flag2 = nobardisplay 
flag3 = noshadow 
ignorehitpause = 1
persistent = 1

[State 190, 1] ;直接进入开局
type = ChangeState
trigger1 = Time = 0
value = 191+random%2
ctrl = 0

;---------------------------------------------------------------------------
; 开场1
[Statedef 191]
type = S
ctrl = 0
anim = 191
velset = 0,0

[State 191]
type = ChangeAnim
trigger1 = RoundState = 0
value = 191

[State 191]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191]
type = PlaySnd
trigger1 = AnimElem = 2
value = 8,0

[State 191]
type = PlaySnd
trigger1 = AnimElem = 17
value = 3,1
volume = 250
channel = 4

[State 191]
type = SprPriority
trigger1 = 1
value = 2

[State 191]
type = ChangeState
trigger1 = AnimTime = 0
value = 4

;---------------------------------------------------------------------------
; 开场2
[Statedef 192]
type = S
ctrl = 0
anim = 192
velset = 0,0

[State 192]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 192]
type = PlaySnd
trigger1 = AnimElem = 3
value = 3,2
volume = 250
channel = 4

[State 192]
type = PlaySnd
trigger1 = AnimElem = 8
value = 3,3
volume = 250
channel = 4

[State 192]
type = PlaySnd
trigger1 = Time = 49 || AnimElem = 9
value = 8,1

[State 192]
type = Explod
trigger1 = AnimElem = 1
anim = 193
ID = 193
sprpriority = 4
postype = P1
pos = 0,0
bindtime = -1
removeongethit = 1
ignorehitpause = 1
persistent = 1

[State 192]
type = Explod
trigger1 = AnimElem = 1
anim = 194
ID = 194
sprpriority = 4
postype = P1
pos = 0,0
bindtime = -1
removeongethit = 1
ignorehitpause = 1
persistent = 1

[State 192]
type = ChangeState
trigger1 = AnimTime = 0
value = 4

;---------------------------------------------------------------------------
; helper
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
;念力球
[Statedef 751]
type    = S                      ;状态: S-站立, C-蹲, A-空中, L-倒地
movetype= I                      ;招式种类: A-攻击, I-非攻击, H-受击
physics = S                      ;物理: S-站立, C-蹲, A-空中
;常用的控制器:
velset = 0,0                     ;设定速度 (x,y) (不写这行则不改变速度)
ctrl = 0                         ;设定可控与否 (不写这行则不改变ctrl)
anim = 9999                       ;改变动作 (不写这行则不改变anim)
sprpriority = 2                  ;设定p1的贴图优先度到2 (在前面


;---------------------------------------------------------------------------
;空动画
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = anim != 9999
value = 9999
ignorehitpause = 1


;---------------------------------------------------------------------------
;不可视,且没影子
[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow
flag2 = invisible
ignorehitpause = 1

;---------------------------------------------------------------------------
;绑定在人物重心
[State 0, BindToParent]
type = BindToParent
trigger1 = 1
time = 1
facing = 0
pos = -2,-55
ignorehitpause = 1

;==================================================================
;收尾设置
[State 0, Null]
type = Null
trigger1 = 1||cond(root,stateno!=750&&var(40)=0,var(40):=1,0)
trigger1 = var(40)>0
trigger1 = var(40):=var(40)+1
trigger1 = 1||fvar(0):=65*(1 - 1.0*var(40)/20)

ignorehitpause = 1

;==================================================================
;随机数设置
[State 0, Null]
type = Null
trigger1 = time = 0 ;只在HELPER创建时启动一次随机
trigger1 = 1||fvar(0):= 65 ;环绕半径
trigger1 = 1||fvar(1):= ishelper(752)*pi*1.2
trigger1 = 1||fvar(2):= Cond(ishelper(751),-0.18,0.18)
trigger1 = 1||fvar(3):= 0.1+random*0.0003 ;轨道Y轴比例随机
trigger1 = 1||fvar(4):= Cond(ishelper(751),1.3,-1.3)*pi ;椭圆轨道倾斜角度


trigger1 = 0 ;保证trigger1不会成立使得后面的代码得以运行


trigger2 = 1||fvar(1):=fvar(1)+fvar(2)
trigger2 = 0 ;保证trigger2不会成立使得后面的代码得以运行


trigger3 = 1||fvar(30):= fvar(0)*(cos(fvar(1))**2+(fvar(3)*sin(fvar(1)))**2)**0.5 ;计算旋转前的中心距
trigger3 = 1||fvar(31):= Atan(fvar(3)*sin(fvar(1))/cos(fvar(1)))+ pi*(cos(fvar(1))<0) ;计算轨道压缩后的新仰角
trigger3 = 1||fvar(5):=fvar(30)*cos(fvar(31)+fvar(4));极坐标轨道方程旋转公式
trigger3 = 1||fvar(6):=fvar(30)*sin(fvar(31)+fvar(4))
trigger3 = 0


ignorehitpause = 1

;==================================================================


[State 0, Explod]
type = Explod
trigger1 = 1
anim = 751+time/2%7
ID = 751
pos = fvar(5),-fvar(6);Y坐标为负数是因为在平面直角坐标系中Y轴正方向在上面，而MUGEN中在下面
postype = p1
facing = 1
vfacing = 1
bindtime = 1
vel = 0,0
accel = 0,0
random = 0,0
removetime = 1
pausemovetime = 0
scale = .8,.8
sprpriority = cond(sin(fvar(1))>0,-2,7);这里表示当环绕角度的正弦为正数时，图层会在人物背后，反之在前面，以此达到环绕演出的效果
ontop = 0
shadow = 0,0,0
ownpal = 1
removeongethit = 0
ignorehitpause =1

;---------------------------------------------------------------------------
;人物状态结束后消除helper
[State 0, DestroySelf] 
type = DestroySelf
trigger1 = var(40) > 20
ignorehitpause = 1

;---------------------------------------------------------------------------
;X型能量球helper
[Statedef 1310]
type    = S                      ;状态: S-站立, C-蹲, A-空中, L-倒地
movetype= A                      ;招式种类: A-攻击, I-非攻击, H-受击
physics = S                      ;物理: S-站立, C-蹲, A-空中
;常用的控制器:
velset = 0,0                     ;设定速度 (x,y) (不写这行则不改变速度)
ctrl = 0                         ;设定可控与否 (不写这行则不改变ctrl)
anim = 1310                       ;改变动作 (不写这行则不改变anim)
sprpriority = 5                  ;设定p1的贴图优先度到2 (在前面)

;---------------------------------------------------------------------------
;Y轴坐标锁定
[State 0, 坐标锁定]
type = PosSet
trigger1 = 1
y = -76
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;攻击判定
[State 1310,1]
type = HitDef
trigger1 = time = 5
attr = , NT                     ;Hitdef属性： 站立，普通攻击
damage = 20, 0                   ;招式造成的伤害, 防御伤害
getpower = 0,0
givepower = 50,0
animtype = Heavy                 ;动作种类: Light-轻, Medium-中, Heavy-重, Back-后仰 (默认: Light)
guardflag = HA                   ;能被什么状态的敌人防御
hitflag = MAF                    ;能击中什么状态的敌人
priority = 7, Hit                ;攻击优先度: 0 (最低) to 7 (最高), 4 默认，相杀式的处理：Hit-可以击中非dodge情况的敌方/Miss-我方攻击一定miss/Dodge-一定躲避敌方攻击 (默认: Hit)
pausetime = 0, 0                 ;攻击者暂停的时间, 对手在hitshake的时间
sparkno = -1                      ;火花的动作号 (默认: 在上面设置的动作好)
sparkxy = -8, -75               ;火花相对于p2的X坐标偏移量，火花相对于p1的Y坐标偏移量
guard.sparkno = -1
hitsound = S100,7                  ;击中时播放的音效
guardsound = S100, 9                ;被防御时播放的音效
ground.type = High               ;种类: High-上段, Low-下段, Trip-绊倒 (默认: Normal)
ground.slidetime = 4             ;对方向后滑的时间
ground.hittime  = 25             ;对方在被击中状态的时间
guard.ctrltime  = 25             ;对方在防御状态的时间
ground.velocity = -2             ;对方被向后推的速度
airguard.velocity = -1.9,-.8     ;空中防御的速度 (默认: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;空中击中的种类: High-上段, Low-下段, Trip-绊倒 (默认: 和ground.type一样)
air.velocity = -1,-3           ;空中击中时对方被向后推的横向速度, 空中击中时对方被向后推的纵向速度
air.hittime = 24                 ;空中击中对方在被击中状态的时间、
envshake.ampl = 4
envshake.freq = 60
envshake.time = 8
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
down.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
ID = 1310

;---------------------------------------------------------------------------
;敌方状态控制

[State 0, 抓取]
type = TargetState
trigger1 = NumTarget
trigger1 = !MoveGuarded
value = 1320
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;p2绑定

[State 0, 位置绑定]
type = TargetBind
trigger1 = Numtarget
trigger1 = !MoveGuarded
time = 1
id = -1
pos = 0,0
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;能量球

[State 0, 能量球]
type = Explod
trigger1 = time = 0
anim = 1311
id = 1310
pos = 0,0
postype = p1
facing = 1
bindtime = -1
vel = 0,0
removetime = 34
pausemovetime = 0
supermovetime = 0
scale = 0.5,0.5
sprpriority = -2
ownpal = 1
ignorehitpause = 1
persistent = 0

[State 0, 能量球遮罩]
type = Explod
trigger1 = time = 0
anim = 1312
id = 1310
pos = 0,0
postype = p1
facing = 1
bindtime = -1
vel = 0,0
removetime = 34
pausemovetime = 0
supermovetime = 0
scale = 0.5,0.5
sprpriority = 20
ownpal = 1
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;音效

[State 0, 能量球音效]
type = PlaySnd
trigger1 = Animelem = 6,=3
value = s8,19
ignorehitpause = 0
persistent = 1

;---------------------------------------------------------------------------
;状态跳转
[State 1310, 3]
type = ChangeState
triggerall = time >= 5
trigger1 = time >= 34
trigger2 = root,movetype = H
value = 1315
ctrl = 0

;---------------------------------------------------------------------------
;X型能量球爆炸
[Statedef 1315]
type    = S                      ;状态: S-站立, C-蹲, A-空中, L-倒地
movetype= A                      ;招式种类: A-攻击, I-非攻击, H-受击
physics = S                      ;物理: S-站立, C-蹲, A-空中
;常用的控制器:
velset = 0,0                     ;设定速度 (x,y) (不写这行则不改变速度)
ctrl = 0                         ;设定可控与否 (不写这行则不改变ctrl)
anim = 9999                       ;改变动作 (不写这行则不改变anim)
sprpriority = 5                  ;设定p1的贴图优先度到2 (在前面)


;---------------------------------------------------------------------------
;震屏

[State 0, EnvShake]
type = EnvShake
trigger1 = time = 0
time = 12
ampl = 8
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;攻击判定

[State 1315]
type = Projectile ;攻击类型
trigger1 = time = 4
projID = 1315 ;飞道ID号
projanim = 1315 ;飞道动画
projhitanim = 9999 ;击中时的动画
projremanim = 9999 ;销毁时的动画
projremove = 1 ;击中后是否消失
projremovetime = 5 ;飞道持续多久后消失
velocity = 0,0;6,0 ;飞道的初速度
accel = 0,0
projpriority = 43967777777 ;优先级
projsprpriority = 5 ;图像优先级
projshadow = 0,0,0 ;影子颜色
offset = 0,0 ;飞道发射的位置
getpower = 100,100
givepower = 50,0
attr = S, SP
animtype = Hard
damage = 80,0
hitflag = MAF
guardflag = MA
hitsound = -1
guardsound = s100,9
pausetime = 0,12
guard.pausetime = 0,12
sparkno = -1
guard.sparkno = -1
sparkxy = 10,-55
ground.type = High
ground.hittime = 20
guard.ctrltime = 20
ground.slidetime = 5
ground.velocity = -5
air.velocity = -3.6,-3.8
air.fall = 1

;---------------------------------------------------------------------------
;敌方状态控制

[State 0, 炸飞]
type = TargetState
trigger1 = NumTarget
trigger1 = time = 4
value = 1321
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;爆炸

[State 0, 爆炸]
type = Explod
trigger1 = time = 0
anim = 1316
id = 1315
pos = 0,0
postype = p1
facing = 1
bindtime = 1
vel = 0,0
removetime = -2
pausemovetime = 0
supermovetime = 0
scale = 1,1
sprpriority = 15
ownpal = 1
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;音效

[State 0, 爆炸音效]
