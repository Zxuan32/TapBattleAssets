physics = N                      ;物理: S-站立, C-蹲, A-空中
;常用的控制器:
velset = 0,0                     ;设定速度 (x,y) (不写这行则不改变速度)
ctrl = 0                         ;设定可控与否 (不写这行则不改变ctrl)
sprpriority = 8                  ;设定p1的贴图优先度到2 (在前面)

;---------------------------------------------------------------------------
;动画修正

[State 0, 动画修正]
type = ChangeAnim
trigger1 = anim != 101145
value = 101145
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;坐标绑定

[State 0, 坐标绑定]
type = PosSet
trigger1 = 1
x = Root,Pos X
y = Root,Pos Y
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
;暂停解除

[State ]
type = Pause
triggerall = name = "Alice"
trigger1 = ishelper(101145)
time = 0
movetime = 0
ignorehitpause = 1

[State ]
type = SuperPause
triggerall = name = "Alice"
trigger1 = ishelper(101145)
anim = -1
darken = 0
p2defmul = 1
unhittable = 0 
time = 0  
movetime = 0 
ignorehitpause = 1

;---------------------------------------------------------------------------
;当身设置

[State 0, 当身设置]
type = ReversalDef
triggerall = name = "Alice"
trigger1 = ishelper(101145)
reversal.attr = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
pausetime = 5,5
sparkno = -1
hitsound = -1
p2stateno = 101919
ignorehitpause = 1
persistent = 1
numhits = 0

;---------------------------------------------------------------------------
;状态控制

[State 0, 状态控制]
type = TargetState
triggerall = name = "Alice"
triggerall = ishelper(101145)
triggerall = NumTarget
trigger1 = (target, Alive)
trigger1 = (target,stateno != 101919) && (target,stateno != 108100)
value = 108100
ID = -1
ignorehitpause = 1
persistent = 1

