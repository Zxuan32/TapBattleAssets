// Casa de Buu.
stage {
    width = 1856;
    layer far {
        place "00.png" at -164, -594 repeat;
    }
    layer mid {
        place "01.png" at -164, 80 repeat hd 2;
    }
    layer ground {
        place "02.png" at -164, -434 repeat hd 2;
    }
    chase {
        background "03.png" at 0, -594;
    }
}
