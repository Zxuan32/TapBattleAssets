// Laboratorio del Dr. Gero (Super Butouden 2). Fondos de DSP27 (dsp27.deviantart.com).
stage {
    width = 3072;

    layer far {
        place "00.png" at 0, -319 repeat;
    }

    layer mid {
        place "01.png" at 72, -92;
    }

    layer ground {
        place "02.png" at 0, 203 repeat;
        place "03.png" at -84, 8;
        place "04.png" at -504, 112;
        place "05.png" at 1044, 137;
    }

    chase {
        front "06.png" at 0, 203;
        background "07.png" at 0, 3 sky 200 below 120;
    }
}
