package "char00.pac" {
    // Contenido del .pac, EN ORDEN: asi lo lee GameData.Init y el
    // orden es significativo. El numero de 'image' es la hoja que
    // nombra 'sheet' en sprites.tbs, y el de 'sound' la voz que pide
    // 'sound = N' en animation.tbs. Mover una entrada renumera todas
    // las de su tipo, asi que se anade al final ('extract.py adopt').
    //
    // Una voz N se pide desde un frame con 'sound = 80 + N':
    // TCBManajer1 /*00DC1*/ hace playAudio(no - 80); por debajo de 80
    // /*00DBD*/ es un se_NN.ogg suelto, no una voz del personaje.
    //
    // 'extra' son 4 bytes que el juego NO LEE: GameData.Init saca de
    // cada entrada el offset (pos+0..3), el tamano (pos+4..7) y el
    // tipo (pos+8..11), y a decodeData solo le pasa esos tres; los
    // pos+12..15 no los toca nadie. Tampoco son checksum: hay tres
    // wav de contenido identico con tres 'extra' distintos. Se
    // conservan tal cual solo para que el .pac salga identico; en una
    // entrada nueva se deja sin poner y ya.

    image   "png00.png"   extra = 0x30c4eb00;   // hoja 0
    image   "png01.png"   extra = 0x0b7bc600;   // hoja 1
    image   "png02.png"   extra = 0x1a257b00;   // hoja 2
    image   "png03.png"   extra = 0x8b5f3200;   // hoja 3
    image   "png04.png"   extra = 0xa4574e00;   // hoja 4
    image   "png05.png"   extra = 0x6932ea00;   // hoja 5
    image   "png06.png"   extra = 0xb6544c00;   // hoja 6
    image   "png07.png"   extra = 0xd6302b00;   // hoja 7
    image   "png08.png"   extra = 0xf0005500;   // hoja 8
    image   "png09.png"   extra = 0x24d2df00;   // hoja 9
    image   "png10.png"   extra = 0x667bb000;   // hoja 10
    image   "png11.png"   extra = 0xb9040d00;   // hoja 11
    image   "png12.png"   extra = 0x797ab100;   // hoja 12
    image   "png13.png"   extra = 0x4a01cb00;   // hoja 13
    image   "png14.png"   extra = 0xafe4d700;   // hoja 14
    image   "png15.png"   extra = 0x34ff2e00;   // hoja 15
    image   "png16.png"   extra = 0x4ba04400;   // hoja 16
    image   "png17.png"   extra = 0x26ad2200;   // hoja 17
    image   "png18.png"   extra = 0x637e3c00;   // hoja 18
    tables  "tables.tbs"  extra = 0x42ec5d00;
    sprites "sprites.tbs" extra = 0x52ff6e00;
    anim    "anim.tbs"    extra = 0x87e19a00;
    sound   "wav00.wav"   extra = 0x21a76300;   // 22050 Hz, 16 bit, mono, 0.96 s
    sound   "wav01.wav"   extra = 0xf774e100;   // 22050 Hz, 16 bit, mono, 0.53 s
    sound   "wav02.wav"   extra = 0x179f5f00;   // 22050 Hz, 16 bit, mono, 0.54 s
    sound   "wav03.wav"   extra = 0x766dbc00;   // 22050 Hz, 16 bit, mono, 0.93 s
    sound   "wav04.wav"   extra = 0xa43d3f00;   // 22050 Hz, 16 bit, mono, 1.92 s
    sound   "wav05.wav"   extra = 0x586ffe00;   // 22050 Hz, 16 bit, mono, 0.30 s
    sound   "wav06.wav"   extra = 0xbae92400;   // 22050 Hz, 16 bit, mono, 0.94 s
    sound   "wav07.wav"   extra = 0x1e6fb500;   // 22050 Hz, 16 bit, mono, 0.28 s
    sound   "wav08.wav"   extra = 0x9dfc8300;   // 22050 Hz, 16 bit, mono, 0.76 s
    sound   "wav09.wav"   extra = 0xf66f5d00;   // 22050 Hz, 16 bit, mono, 1.28 s
    sound   "wav10.wav"   extra = 0x88b24000;   // 22050 Hz, 16 bit, mono, 2.10 s
    sound   "wav11.wav"   extra = 0xad172500;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav12.wav"   extra = 0xc46feb00;   // 22050 Hz, 16 bit, mono, 1.32 s
    sound   "wav13.wav"   extra = 0x416c3900;   // 22050 Hz, 16 bit, mono, 1.36 s
    sound   "wav14.wav"   extra = 0xd72b5800;   // 22050 Hz, 16 bit, mono, 1.25 s
    sound   "wav15.wav"   extra = 0xbdb7ef00;   // 22050 Hz, 16 bit, mono, 1.08 s
    sound   "wav16.wav"   extra = 0xc1df0700;   // 22050 Hz, 16 bit, mono, 0.67 s
    sound   "wav17.wav"   extra = 0x8b929c00;   // 22050 Hz, 16 bit, mono, 1.39 s
    info    "info.tbs";
}
