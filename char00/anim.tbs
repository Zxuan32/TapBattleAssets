            time = 3; sprite = sprite_3; origin = -39, -113;
            hurtbox       at -31, -103  size 64, 96;
            spawn ano_207 at  44,  -72;
        }
        frame {
            time = 3; sprite = sprite_3; origin = -39, -113; loop;
            hurtbox       at -31, -103  size 64, 96;
            spawn ano_207 at  44,  -72;
        }
    }

