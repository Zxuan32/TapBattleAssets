        text_31 = "Prueba mixta 24";
        text_32 = "Prueba";
        text_33 = "¡Ataca con todo y gana!_¡Una táctica pensada para atacar!";
        text_34 = "¡Usa saltos y vuelo_y pelea desde el aire!";
        text_35 = "¡Una táctica equilibrada entre disparos,_curación y súper especiales!";
        text_36 = "¡Cúrate, deja que se acerque y acábalo!_¡Una táctica de ataque arrollador!";
        text_37 = "¡Una táctica equilibrada que va bien_con cualquier personaje!";
        text_38 = "¡Con un personaje que vuela y dispara,_esta táctica es devastadora!";
        text_39 = "¡Ataques rápidos y curación para_sacarle todo al personaje!";
        text_40 = "¡Si confías en tu velocidad y ataque,_sirve contra rivales de nivel alto!";
        text_41 = "¡Ataca con todo y decide la pelea!_¡Una táctica de ataque destructiva!";
        text_42 = "¡Usa muchas técnicas para presionar!_¡Táctica avanzada para personajes potentes!";
        text_43 = "¡Ataques tranquilos pero arrolladores!_¡Una táctica fuerte y sin descuidos!";
        text_44 = "¡Solo para personajes poderosos:_una táctica de poder descomunal!";
        text_45 = "¿Habrá remontada? ¡La táctica definitiva_que recomienda el campeón mundial!";
        text_46 = "¡Con la táctica de los guerreros elegidos,_busca ser el más fuerte!";
        text_47 = "¡Pelea con la táctica más fuerte!_¡Una carta de táctica rara de nivel máximo!";
        text_48 = "¡Supera incluso al guerrero más fuerte!_¡Una carta de táctica rara de nivel máximo!";
        text_49 = "Prueba mixta de IA";
