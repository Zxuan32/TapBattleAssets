animation {
    anos  = 5;
    padding = 1;

    ano_0 {
        frame { sprite = sprite_0; }
    }

    ano_1 {
        frame { sprite = sprite_1; }
    }

    ano_2 {
        frame { sprite = sprite_2; }
    }

    ano_3 {
        frame { sprite = sprite_3; }
    }

    ano_4 {
        frame { sprite = sprite_4; }
    }
}
