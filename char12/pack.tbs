package "char12.pac" {
    // Contenido del .pac, EN ORDEN: asi lo lee GameData.Init y el
    // orden es significativo. El numero de 'image' es la hoja que
    // nombra 'sheet' en sprites.tbs, y el de 'sound' la voz que pide
    // 'sound = N' en animation.tbs. Mover una entrada renumera todas
    // las de su tipo, asi que se anade al final ('extract.py adopt').
    //
    // Una voz N se pide desde un frame con 'sound = 80 + N':
    // TCBManajer1 /*00DC1*/ hace playAudio(no - 80); por debajo de 80
    // /*00DBD*/ es un se_NN.ogg suelto, no una voz del personaje.
    //
    // 'extra' son 4 bytes que el juego NO LEE: GameData.Init saca de
    // cada entrada el offset (pos+0..3), el tamano (pos+4..7) y el
    // tipo (pos+8..11), y a decodeData solo le pasa esos tres; los
    // pos+12..15 no los toca nadie. Tampoco son checksum: hay tres
    // wav de contenido identico con tres 'extra' distintos. Se
    // conservan tal cual solo para que el .pac salga identico; en una
    // entrada nueva se deja sin poner y ya.

    image   "png00.png"   extra = 0xb82ea800;   // hoja 0
    image   "png01.png"   extra = 0x5ee79e00;   // hoja 1
    image   "png02.png"   extra = 0xf3331700;   // hoja 2
    image   "png03.png"   extra = 0x4e9cf000;   // hoja 3
    image   "png04.png"   extra = 0x88a04000;   // hoja 4
    image   "png05.png"   extra = 0x69011f00;   // hoja 5
    image   "png06.png"   extra = 0x41ae2200;   // hoja 6
    image   "png07.png"   extra = 0x727eca00;   // hoja 7
    image   "png08.png"   extra = 0x79e88400;   // hoja 8
    image   "png09.png"   extra = 0x1e8b6400;   // hoja 9
    image   "png10.png"   extra = 0xc5b65e00;   // hoja 10
    image   "png11.png"   extra = 0x69f7d100;   // hoja 11
    image   "png12.png"   extra = 0x064d9200;   // hoja 12
    image   "png13.png"   extra = 0xa2a3b700;   // hoja 13
    image   "png14.png"   extra = 0x7231d400;   // hoja 14
    image   "png15.png"   extra = 0xe214f700;   // hoja 15
    image   "png16.png"   extra = 0x1a439800;   // hoja 16
    image   "png17.png"   extra = 0xfdb58300;   // hoja 17
    tables  "tables.tbs"  extra = 0x83e3af00;
    sprites "sprites.tbs" extra = 0x2dac7500;
    anim    "anim.tbs"    extra = 0x57951500;
    sound   "wav00.wav"   extra = 0x3b1d1000;   // 22050 Hz, 16 bit, mono, 1.04 s
    sound   "wav01.wav"   extra = 0x5493f300;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav02.wav"   extra = 0xe44ced00;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav03.wav"   extra = 0x89cf3600;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav04.wav"   extra = 0xdb858c00;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav05.wav"   extra = 0xb5aa8b00;   // 22050 Hz, 16 bit, mono, 0.63 s
    sound   "wav06.wav"   extra = 0x21a29c00;   // 22050 Hz, 16 bit, mono, 0.63 s
    sound   "wav07.wav"   extra = 0x5d6a5000;   // 22050 Hz, 16 bit, mono, 0.75 s
    sound   "wav08.wav"   extra = 0xb786e000;   // 22050 Hz, 16 bit, mono, 0.77 s
    sound   "wav09.wav"   extra = 0xa9a80b00;   // 22050 Hz, 16 bit, mono, 1.30 s
    sound   "wav10.wav"   extra = 0x1b382500;   // 22050 Hz, 16 bit, mono, 1.62 s
    sound   "wav11.wav"   extra = 0x6e5e4100;   // 22050 Hz, 16 bit, mono, 1.48 s
    sound   "wav12.wav"   extra = 0xdaccff00;   // 22050 Hz, 16 bit, mono, 1.56 s
    sound   "wav13.wav"   extra = 0x53cd4700;   // 22050 Hz, 16 bit, mono, 1.55 s
    sound   "wav14.wav"   extra = 0x3c7cfb00;   // 22050 Hz, 16 bit, mono, 1.04 s
    info    "info.tbs";
}
