package "char05.pac" {
    // Contenido del .pac, EN ORDEN: asi lo lee GameData.Init y el
    // orden es significativo. El numero de 'image' es la hoja que
    // nombra 'sheet' en sprites.tbs, y el de 'sound' la voz que pide
    // 'sound = N' en animation.tbs. Mover una entrada renumera todas
    // las de su tipo, asi que se anade al final ('extract.py adopt').
    //
    // Una voz N se pide desde un frame con 'sound = 80 + N':
    // TCBManajer1 /*00DC1*/ hace playAudio(no - 80); por debajo de 80
    // /*00DBD*/ es un se_NN.ogg suelto, no una voz del personaje.
    //
    // 'extra' son 4 bytes que el juego NO LEE: GameData.Init saca de
    // cada entrada el offset (pos+0..3), el tamano (pos+4..7) y el
    // tipo (pos+8..11), y a decodeData solo le pasa esos tres; los
    // pos+12..15 no los toca nadie. Tampoco son checksum: hay tres
    // wav de contenido identico con tres 'extra' distintos. Se
    // conservan tal cual solo para que el .pac salga identico; en una
    // entrada nueva se deja sin poner y ya.

    image   "png00.png"   extra = 0x1dbe2300;   // hoja 0
    image   "png01.png"   extra = 0xb5ca3500;   // hoja 1
    image   "png02.png"   extra = 0x89a0ca00;   // hoja 2
    image   "png03.png"   extra = 0x649a5200;   // hoja 3
    image   "png04.png"   extra = 0xb42d8c00;   // hoja 4
    image   "png05.png"   extra = 0xbba5f100;   // hoja 5
    image   "png06.png"   extra = 0x52b96c00;   // hoja 6
    image   "png07.png"   extra = 0x4a51e200;   // hoja 7
    image   "png08.png"   extra = 0x37a71e00;   // hoja 8
    image   "png09.png"   extra = 0xc21aa100;   // hoja 9
    image   "png10.png"   extra = 0x82c9db00;   // hoja 10
    image   "png11.png"   extra = 0xd605b500;   // hoja 11
    image   "png12.png"   extra = 0xd38df300;   // hoja 12
    image   "png13.png"   extra = 0xc0cb2500;   // hoja 13
    image   "png14.png"   extra = 0xdeff2a00;   // hoja 14
    image   "png15.png"   extra = 0x17685f00;   // hoja 15
    image   "png16.png"   extra = 0x05c04100;   // hoja 16
    image   "png17.png"   extra = 0x62fe9400;   // hoja 17
    image   "png18.png"   extra = 0x0b555500;   // hoja 18
    image   "png19.png"   extra = 0x1a23f600;   // hoja 19
    tables  "tables.tbs"  extra = 0xda4b0d00;
    sprites "sprites.tbs" extra = 0xb5fc2a00;
    anim    "anim.tbs"    extra = 0xa86d9700;
    sound   "wav00.wav"   extra = 0x17215b00;   // 22050 Hz, 16 bit, mono, 1.67 s
    sound   "wav01.wav"   extra = 0xb8560600;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav02.wav"   extra = 0x47086800;   // 22050 Hz, 16 bit, mono, 1.26 s
    sound   "wav03.wav"   extra = 0xca3a2b00;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav04.wav"   extra = 0x60800500;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav05.wav"   extra = 0xf1139500;   // 22050 Hz, 16 bit, mono, 0.47 s
    sound   "wav06.wav"   extra = 0xb2ec1600;   // 22050 Hz, 16 bit, mono, 0.95 s
    sound   "wav07.wav"   extra = 0xcc7c8d00;   // 22050 Hz, 16 bit, mono, 0.60 s
    sound   "wav08.wav"   extra = 0xd2d74d00;   // 22050 Hz, 16 bit, mono, 0.51 s
    sound   "wav09.wav"   extra = 0xb6988100;   // 22050 Hz, 16 bit, mono, 1.58 s
    sound   "wav10.wav"   extra = 0xd9586700;   // 22050 Hz, 16 bit, mono, 1.56 s
    sound   "wav11.wav"   extra = 0x74697e00;   // 22050 Hz, 16 bit, mono, 1.79 s
    sound   "wav12.wav"   extra = 0x7147f400;   // 22050 Hz, 16 bit, mono, 2.01 s
    sound   "wav13.wav"   extra = 0xf0b8c500;   // 22050 Hz, 16 bit, mono, 1.44 s
    sound   "wav14.wav"   extra = 0xc46cdf00;   // 22050 Hz, 16 bit, mono, 1.76 s
    info    "info.tbs";
}
