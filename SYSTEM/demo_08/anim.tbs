animation {
    anos  = 14;
    padding = 1;

    ano_0 {
        link ano_8 { flag = 4; }
        link ano_5 { flag = 4; }
        frame { time = 50; sprite = sprite_0; origin = 128, 62; }
        frame { time = 1; sprite = sprite_0; origin = 128, 62; }
    }

    ano_1 {
        link ano_8 { flag = 4; }
        frame { time = 120; sprite = sprite_0; origin = 128, 62; }
    }

    ano_2 {
        link ano_8 { flag = 4; }
        link ano_6 { flag = 4; }
        frame { time = 50; sprite = sprite_0; origin = 128, 62; }
        frame { time = 30; sprite = sprite_0; origin = 128, 62; }
        frame { time = 50; sprite = sprite_1; origin = 180, 99; }
        frame { time = 1; sprite = sprite_1; origin = 180, 99; }
    }

    ano_3 {
        link ano_8 { flag = 4; }
        frame { time = 120; sprite = sprite_1; origin = 180, 99; }
    }

    ano_4 {
        link ano_9 { flag = 4; }
        link ano_10 { flag = 4; }
        link ano_7 { flag = 4; }
        frame { time = 50; sprite = sprite_1; origin = 180, 99; }
        frame { time = 1; sprite = sprite_1; origin = 180, 99; }
        frame { time = 1; sprite = -1; origin = 180, 99; }
    }

    ano_5 {
        priority = 254;
        frame {
            time = 50; sprite = sprite_2; origin = -88, -15;
            render { rotate = 0; alpha = 0; zoom = 220, 210; }
            options { tween; }
        }
        frame {
            time = 1; sprite = sprite_2; origin = -88, -15;
            render { rotate = 0; alpha = 255; zoom = 220, 210; }
        }
    }

    ano_6 {
        priority = 254;
        frame {
            time = 50; sprite = sprite_2; origin = -88, -15;
            render { rotate = 0; alpha = 255; zoom = 220, 210; }
            options { tween; }
        }
        frame {
            time = 30; sprite = sprite_2; origin = -88, -15;
            render { rotate = 0; alpha = 0; zoom = 220, 210; }
        }
        frame {
            time = 50; sprite = sprite_2; origin = -88, -15;
            render { rotate = 0; alpha = 0; zoom = 220, 210; }
            options { tween; }
        }
        frame {
            time = 1; sprite = sprite_2; origin = -88, -15;
            render { rotate = 0; alpha = 255; zoom = 220, 210; }
        }
    }

    ano_7 {
        priority = 254;
        frame {
            time = 50; sprite = sprite_2; origin = -88, -15;
            render { rotate = 0; alpha = 255; zoom = 220, 210; }
            options { tween; }
        }
        frame {
            time = 1; sprite = sprite_2; origin = -88, -15;
            render { rotate = 0; alpha = 0; zoom = 220, 210; }
        }
        frame {
            time = 1; sprite = -1; origin = -88, -15;
            render { rotate = 0; alpha = 0; zoom = 220, 210; }
        }
    }

    ano_8 {
        frame {
            time = 1; sprite = sprite_2; origin = -88, -15;
            render { rotate = 0; alpha = 0; zoom = 220, 210; }
        }
    }

    ano_9 {
        frame {
            time = 60; sprite = sprite_2; origin = -88, -15;
            render { rotate = 0; alpha = 0; zoom = 220, 210; }
        }
        frame {
            time = 50; sprite = sprite_2; origin = -88, -15;
            render { rotate = 0; alpha = 0; zoom = 220, 210; }
            options { tween; }
        }
        frame {
            time = 1; sprite = sprite_2; origin = -88, -15;
            render { rotate = 0; alpha = 255; zoom = 220, 210; }
        }
    }

    ano_10 {
        frame {
            time = 1; sprite = sprite_3; origin = -119, -15;
            render { rotate = 0; alpha = 0; zoom = 999, 210; }
        }
    }

    ano_11 {
        link ano_12 { flag = 4; }
        frame { time = 1; sprite = sprite_4; origin = -32, -32; }
    }

    ano_12 {
        priority = 255;
        frame {
            time = 60; sprite = sprite_5; origin = -32, -32;
            options { tween; }
        }
        frame {
            time = 1; sprite = sprite_5; origin = -32, -32; loop;
            render { rotate = 359; alpha = 0; zoom = 100, 100; }
        }
    }

    ano_13 {
        frame { sprite = sprite_6; origin = -49, -8; }
    }
}
