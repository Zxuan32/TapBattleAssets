// Ejemplo de escena (fase 3 de docs/17): fondo y titulo propios, tres estandartes por lado en el
// 3 contra 3, rejilla en trapecio y un boton LISTO para confirmar. Para probarla, copiar esta
// carpeta encima de SYSTEM/selectscene (scene.tbs e images/) y compilar.
scene "Equipos" {
    size = 480, 320;

    image fondo  { image = "fondo@1x.png"; x = 240; y = 0; pivot = top; layer = 0; }
    image titulo { image = "titulo.png"; x = 240; y = 3; pivot = top; layer = 60;
                   on enter { from y = -40; from alpha = 0; time = 20; }
                   loop { to alpha = 170; time = 45; ease = in_out; then to alpha = 255; time = 45; ease = in_out; } }
    anim modo    { anim = "chardemo99:{246 + mode}"; x = 240; y = 44; zoom = 55; layer = 61;
                   on enter { from alpha = 0; time = 30; } }

    template side {
        // 1 contra 1: un estandarte grande y el luchador delante
        bind art      { what = art; fallback = "chardemo99:252"; x = 0; y = 36; zoom = 85; anchor = left;
                        visible = "team_size == 1"; layer = 10;
                        on enter { from x = -180; time = 18; }
                        on change { from alpha = 0; from x = -30; time = 8; } }
        bind fighter  { what = fighter; x = 92; y = 300; zoom = 85; anchor = left;
                        visible = "team_size == 1"; layer = 20;
                        on change { from alpha = 0; from x = -15; time = 8; } }
        anim unknown  { anim = "chardemo99:251"; x = 92; y = 300; anchor = left; mirror = move;
                        visible = "team_size == 1 and not who.has_fighter"; layer = 20; }

        // 3 contra 3: un estandarte por miembro, del primero (atras) al tercero (delante)
        bind art1     { what = art; member = 1; fallback = "chardemo99:252"; x = 0; y = 40; zoom = 52;
                        anchor = left; visible = "team_size == 3"; layer = 11;
                        on enter { from x = -200; time = 14; } }
        image marco1  { image = "marco.png"; x = 0; y = 40; anchor = left; visible = "team_size == 3";
                        on enter { from x = -200; time = 14; } }
        bind art2     { what = art; member = 2; fallback = "chardemo99:252"; x = 46; y = 46; zoom = 52;
                        anchor = left; visible = "team_size == 3";
                        on enter { from x = -200; time = 18; } on change { from alpha = 0; time = 8; } }
        image marco2  { image = "marco.png"; x = 46; y = 46; anchor = left; visible = "team_size == 3";
                        on enter { from x = -200; time = 18; } }
        bind art3     { what = art; member = 3; fallback = "chardemo99:252"; x = 92; y = 52; zoom = 52;
                        anchor = left; visible = "team_size == 3";
                        on enter { from x = -200; time = 22; } on change { from alpha = 0; time = 8; } }
        image marco3  { image = "marco.png"; x = 92; y = 52; anchor = left; visible = "team_size == 3";
                        on enter { from x = -200; time = 22; } }
        bind fighter1 { what = fighter; member = 1; x = 36; y = 292; zoom = 60; anchor = left;
                        visible = "team_size == 3"; layer = 21; }
        bind fighter2 { what = fighter; member = 2; x = 82; y = 298; zoom = 62; anchor = left;
                        visible = "team_size == 3"; on change { from alpha = 0; time = 8; } }
        bind fighter3 { what = fighter; member = 3; x = 128; y = 304; zoom = 64; anchor = left;
                        visible = "team_size == 3"; on change { from alpha = 0; time = 8; } }

        // el nombre del que esta bajo el cursor y quien juega
        image cinta   { image = "cinta.png"; x = 4; y = 280; anchor = left; layer = 40; }
        bind nombre   { what = name_plate; x = 14; y = 283; zoom = 40; anchor = left; mirror = move; w = 148;
                        visible = "not who.empty"; }
        anim azar     { anim = "chardemo99:{who.random ? 253 : 255}"; x = 14; y = 290; anchor = left;
                        mirror = move; w = 60; visible = "who.empty and (who.random or who.waiting)"; }
        anim tag      { anim = "chardemo99:{who.cpu ? 244 : 242 + who.index}"; x = 6; y = 262; anchor = left;
                        mirror = move; w = 30; }
    }
    use side for p1;
    use side for p2 { mirror; }

    template card {
        bind portrait     { what = portrait; zoom = "cell.zoom", "cell.zoom_y"; layer = 70; }
        anim random       { anim = "chardemo99:235"; zoom = "cell.zoom", "cell.zoom_y"; visible = "cell.random"; layer = 70; }
        anim badge        { anim = "chardemo99:233"; zoom = "cell.zoom", "cell.zoom_y"; visible = "cell.transformable";
                            x = "16 * cell.zoom / 100"; y = "12 * cell.zoom / 100 - cell.h"; layer = 71; }
        anim picked       { anim = "chardemo99:98"; zoom = "cell.zoom", "cell.zoom_y"; visible = "cell.picked"; layer = 71; }
        anim cursor_other { anim = "chardemo99:{237 - chooser}"; zoom = "cell.zoom", "cell.zoom_y"; visible = "cell.other"; }
        anim cursor_own   { anim = "chardemo99:{236 + chooser}"; zoom = "cell.zoom", "cell.zoom_y"; visible = "cell.own"; }
    }

    grid roster {
        pattern = trapezoid; row_cols = 7, 8, 9; grow = 12;
        pitch = 27, 34; zoom = 50; random_cell = 3; overflow = pages;
        card = card; x = 240; y = 196;
    }

    anim pagina_izq { anim = "common:27"; x = 70; y = 240; visible = "pages > 1"; layer = 80;
                      action = page_prev; hit = -23, -30, 46, 60; }
    anim pagina_der { anim = "common:29"; x = 410; y = 240; visible = "pages > 1"; layer = 80;
                      action = page_next; hit = -23, -30, 46, 60; }
    image listo     { image = "listo.png"; x = 240; y = 284; pivot = top; layer = 81; action = confirm;
                      loop { to zoom = 108; time = 30; ease = in_out; then to zoom = 100; time = 30; ease = in_out; } }
}
