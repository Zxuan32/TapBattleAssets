// PlanetaKaioshin: escenario de MUGEN (PlanetaKaioshin.def + PlanetaKaioshin.sff),
// con tools/mugen_stage.py a escala 1.25, el fondo en espejo. Seccion 37 de docs/MODDING.md.
stage {
    width = 960;
    layer ground {
        place "00.png" at 6, -284 repeat;
        place "01.png" at 292, 8 add;
        place "01.png" at 608, 8 mirror add;
        place "02.png" at -12, 116 add slide -1539 repeat;
        place "03.png" at 90, 108 add;
        place "03.png" at 839, 108 mirror add;
    }
    chase {
        background "04.png" at 0, -84 sky 200;
    }
}
