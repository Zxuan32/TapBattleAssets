// Planet of god: capas de Planet of god, con
// tools/bg_capas.py a escala 0.625, pasadas por Real-ESRGAN, media y suelo a hd 2.
// Seccion 34g de docs/MODDING.md.
escenario {
    ancho = 1280;
    capa lejos {
        pon "00.png" at -20, -254 repite;
    }
    capa media {
        pon "01.png" at -20, -94 repite hd 2;
    }
    capa suelo {
        pon "02.png" at -20, -94 repite hd 2;
    }
    persecucion {
        fondo "03.png" at 0, -254;
    }
}
