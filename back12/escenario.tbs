// Planet of god: capas de Planet of god, con
// tools/bg_capas.py a escala 0.625, pasadas por Real-ESRGAN, media y suelo a hd 2.
// Seccion 34g de docs/MODDING.md.
stage {
    width = 1280;
    layer far {
        place "00.png" at -20, -254 repeat;
    }
    layer mid {
        place "01.png" at -20, -94 repeat hd 2;
    }
    layer ground {
        place "02.png" at -20, -94 repeat hd 2;
    }
    chase {
        background "03.png" at 0, -254;
    }
}
