// Capsule Corp. Fondos de DSP27 (dsp27.deviantart.com), sacados con
// tools/recorta_dsp27.py. Seccion 34 de docs/MODDING.md.
// Medidas en pixeles del mundo (480x320) con la camara quieta: pies en y=240.
stage {
    width = 2048;

    // 1/3 de la camara: el cielo morado con el mar y las torres lejanas,
    // cuatro veces con su espejo alterno.
    layer far {
        place "00.png" at 0, -1 sky 300 below 120;
        place "00.png" at 512, -1 mirror sky 300 below 120;
        place "00.png" at 1024, -1 sky 300 below 120;
        place "00.png" at 1536, -1 mirror sky 300 below 120;
    }

    // 1/2 de la camara, para que se vea lejos: la plaza a lo largo de toda
    // la vuelta y, encima, el edificio una vez, corrido para que la puerta
    // salga en medio al empezar.
    layer mid {
        place "02.png" at 0, 195 repeat below 60;
        place "01.png" at -320, -293 below 60;
    }

    // 1:1: el piso de baldosas, delante, con el borde de arriba fundido con
    // la plaza; los pies quedan 35 px dentro.
    layer ground {
        place "03.png" at 0, 205 below 60 fade 24;
        place "03.png" at 512, 205 mirror below 60 fade 24;
        place "03.png" at 1024, 205 below 60 fade 24;
        place "03.png" at 1536, 205 mirror below 60 fade 24;
    }

    // La persecucion (BattleEvents456): el cielo de fondo y la plaza delante,
    // sin el edificio.
    chase {
        front "02.png" at 0, 195 repeat below 60;
        background "04.png" at 0, -1 sky 300 below 120;
    }
}
