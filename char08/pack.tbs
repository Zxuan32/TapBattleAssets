package "char08.pac" {
    // Contenido del .pac, EN ORDEN: asi lo lee GameData.Init y el
    // orden es significativo. El numero de 'image' es la hoja que
    // nombra 'sheet' en sprites.tbs, y el de 'sound' la voz que pide
    // 'sound = N' en animation.tbs. Mover una entrada renumera todas
    // las de su tipo, asi que se anade al final ('extract.py adopt').
    //
    // Una voz N se pide desde un frame con 'sound = 80 + N':
    // TCBManajer1 /*00DC1*/ hace playAudio(no - 80); por debajo de 80
    // /*00DBD*/ es un se_NN.ogg suelto, no una voz del personaje.
    //
    // 'extra' son 4 bytes que el juego NO LEE: GameData.Init saca de
    // cada entrada el offset (pos+0..3), el tamano (pos+4..7) y el
    // tipo (pos+8..11), y a decodeData solo le pasa esos tres; los
    // pos+12..15 no los toca nadie. Tampoco son checksum: hay tres
    // wav de contenido identico con tres 'extra' distintos. Se
    // conservan tal cual solo para que el .pac salga identico; en una
    // entrada nueva se deja sin poner y ya.

    image   "png00.png"   extra = 0xe21fcc00;   // hoja 0
    image   "png01.png"   extra = 0xebf75e00;   // hoja 1
    image   "png02.png"   extra = 0x24535e00;   // hoja 2
    image   "png03.png"   extra = 0x3d91bc00;   // hoja 3
    image   "png04.png"   extra = 0x01947900;   // hoja 4
    image   "png05.png"   extra = 0x988e6e00;   // hoja 5
    image   "png06.png"   extra = 0x2fd98500;   // hoja 6
    image   "png07.png"   extra = 0x14d33900;   // hoja 7
    image   "png08.png"   extra = 0x6ea9ca00;   // hoja 8
    image   "png09.png"   extra = 0x92b37800;   // hoja 9
    image   "png10.png"   extra = 0xcc367900;   // hoja 10
    image   "png11.png"   extra = 0xc035c500;   // hoja 11
    image   "png12.png"   extra = 0xdf2a2900;   // hoja 12
    image   "png13.png"   extra = 0xbdd07600;   // hoja 13
    image   "png14.png"   extra = 0xf3e9c800;   // hoja 14
    image   "png15.png"   extra = 0xd3e84c00;   // hoja 15
    image   "png16.png"   extra = 0xbd4cf700;   // hoja 16
    image   "png17.png"   extra = 0x86ab2300;   // hoja 17
    image   "png18.png"   extra = 0x1abc0a00;   // hoja 18
    image   "png19.png"   extra = 0x74be1700;   // hoja 19
    tables  "tables.tbs"  extra = 0xe3984100;
    sprites "sprites.tbs" extra = 0x521ba300;
    anim    "anim.tbs"    extra = 0xb8acf200;
    sound   "wav00.wav"   extra = 0x233a4f00;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav01.wav"   extra = 0xbac20300;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav02.wav"   extra = 0xcd33ad00;   // 22050 Hz, 16 bit, mono, 3.04 s
    sound   "wav03.wav"   extra = 0xf0990c00;   // 22050 Hz, 16 bit, mono, 1.55 s
    sound   "wav04.wav"   extra = 0xb3f46700;   // 22050 Hz, 16 bit, mono, 0.01 s
    sound   "wav05.wav"   extra = 0xa4f75e00;   // 22050 Hz, 16 bit, mono, 0.39 s
    sound   "wav06.wav"   extra = 0x6e189d00;   // 22050 Hz, 16 bit, mono, 1.22 s
    sound   "wav07.wav"   extra = 0x03d07400;   // 22050 Hz, 16 bit, mono, 0.70 s
    sound   "wav08.wav"   extra = 0x4b9c4d00;   // 22050 Hz, 16 bit, mono, 0.75 s
    sound   "wav09.wav"   extra = 0xd986fa00;   // 22050 Hz, 16 bit, mono, 1.01 s
    sound   "wav10.wav"   extra = 0x2848f200;   // 22050 Hz, 16 bit, mono, 1.08 s
    sound   "wav11.wav"   extra = 0xfb76c500;   // 22050 Hz, 16 bit, mono, 1.51 s
    sound   "wav12.wav"   extra = 0x268ca300;   // 22050 Hz, 16 bit, mono, 1.50 s
    sound   "wav13.wav"   extra = 0x6b776b00;   // 22050 Hz, 16 bit, mono, 1.82 s
    sound   "wav14.wav"   extra = 0xa73d3200;   // 22050 Hz, 16 bit, mono, 1.34 s
    info    "info.tbs";
}
