// Kame House. Fondos de DSP27 (dsp27.deviantart.com), sacados con
// tools/recorta_dsp27.py. Seccion 34 de docs/MODDING.md.
// Medidas en pixeles del mundo (480x320) con la camara quieta: pies en y=240.
stage {
    width = 2048;

    // 1/3 de la camara: el cielo con nubes, cuatro veces con su espejo alterno.
    layer far {
        place "00.png" at 0, -81 sky 300 below 120;
        place "00.png" at 512, -81 mirror sky 300 below 120;
        place "00.png" at 1024, -81 sky 300 below 120;
        place "00.png" at 1536, -81 mirror sky 300 below 120;
    }

    // 1/2 de la camara, para que se vea lejos (su arena empieza en y=205, donde
    // la de delante): la casa con las palmeras una
    // vez, corrida para que la puerta salga en medio al empezar, y en el resto
    // de la vuelta mar, pasto y arena que empalman con los dos bordes (02.png,
    // de x=605 a 1629).
    layer mid {
        place "01.png" at -419, -223 below 60;
        place "02.png" at 605, 109 below 60;
    }

    // 1:1: la arena, delante, fundida con la arena de la media, que empieza
    // a la misma altura; los pies quedan 35 px dentro.
    layer ground {
        place "03.png" at 0, 205 below 60 fade 24;
        place "03.png" at 512, 205 mirror below 60 fade 24;
        place "03.png" at 1024, 205 below 60 fade 24;
        place "03.png" at 1536, 205 mirror below 60 fade 24;
    }

    // La persecucion (BattleEvents456): el cielo de fondo y mar, pasto y arena
    // delante, sin la casa.
    chase {
        front "05.png" at 0, 109 below 60;
        background "04.png" at 0, -81 sky 300 below 120;
    }
}
