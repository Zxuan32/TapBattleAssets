// Karim Tower: capas de Karim Tower, con
// tools/bg_capas.py a escala 0.9, pasadas por Real-ESRGAN, media y suelo a hd 2.
// Seccion 34g de docs/MODDING.md.
stage {
    width = 1856;
    layer far {
        place "00.png" at -164, -405 repeat;
    }
    layer mid {
        place "01.png" at -164, -245 repeat hd 2;
    }
    layer ground {
        place "02.png" at -164, -245 repeat hd 2;
    }
    chase {
        background "03.png" at 0, -405;
    }
}
