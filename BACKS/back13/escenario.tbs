// Planeta del Kaioshin: escenario de MUGEN (PlanetaKaioshin).
stage {
    width = 960;
    layer ground {
        place "spr00/png00.png" at 6, -284 repeat;
        place "spr00/png01.png" at 292, 8 add;
        place "spr00/png01.png" at 608, 8 mirror add;
        place "spr00/png02.png" at -12, 116 add slide -1539 repeat;
        place "spr00/png03.png" at 90, 108 add;
        place "spr00/png03.png" at 839, 108 mirror add;
    }
    chase {
        background "spr00/png04.png" at 0, -84 sky 200;
    }
}
