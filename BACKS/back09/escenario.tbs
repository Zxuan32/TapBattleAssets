// Casa de Buu.
stage {
    width = 1856;
    layer far {
        place "spr00/png00.png" at -164, -594 repeat;
    }
    layer mid {
        place "spr00/png01.png" at -164, 80 repeat hd 2;
    }
    layer ground {
        place "spr00/png02.png" at -164, -434 repeat hd 2;
    }
    chase {
        background "spr00/png03.png" at 0, -594;
    }
}
