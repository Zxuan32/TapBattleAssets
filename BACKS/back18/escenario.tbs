// Interior de Buu: escenario de MUGEN (buu1).
stage {
    width = 1280;
    in_order;              // el piso tapa el pie de las salpicaduras
    layer ground {
        place "spr00/png00.png" at -78, -119;
        place "spr00/png00.png" at 562, -119 mirror;
        place "spr00/png01.png" at -78, -113;
        place "spr00/png01.png" at 562, -113;
    }
    chase {
        background "spr00/png02.png" at 0, -119 sky 200;
    }
}
