// Laboratorio del Dr. Gero (Super Butouden 2). Fondos de DSP27 (dsp27.deviantart.com).
stage {
    width = 3072;

    layer far {
        place "spr00/png00.png" at 0, -319 repeat;
    }

    layer mid {
        place "spr00/png01.png" at 72, -92;
    }

    layer ground {
        place "spr00/png02.png" at 0, 203 repeat;
        place "spr00/png03.png" at -84, 8;
        place "spr00/png04.png" at -504, 112;
        place "spr00/png05.png" at 1044, 137;
    }

    chase {
        front "spr00/png06.png" at 0, 203;
        background "spr00/png07.png" at 0, 3 sky 200 below 120;
    }
}
