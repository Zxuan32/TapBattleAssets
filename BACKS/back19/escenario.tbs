// Infierno de Janemba: escenario de MUGEN (jan2).
stage {
    width = 1920;
    in_order;              // el piso tapa el pie de las salpicaduras
    layer far {
        place "spr00/png00.png" at -400, -614;
    }
    layer mid {
        place "spr00/png01.png" at -400, -645;
    }
    layer ground {
        place "spr00/png02.png" at -400, 6;
    }
    chase {
        background "spr00/png03.png" at 0, -711 sky 200;
    }
}
