// Habitacion del Tiempo: escenario de MUGEN (Time_Chamber_HR).
stage {
    width = 1664;
    layer far {
        place "spr00/png00.png" at -114, -239 repeat;
        place "spr00/png01.png" at 101, -91 add 50;
        place "spr00/png01.png" at 517, -91 add 50;
        place "spr00/png01.png" at 933, -91 add 50;
        place "spr00/png01.png" at 1349, -91 add 50;
        place "spr00/png03.png" at 43, 98 add repeat;
    }
    drift far -4;
    layer ground {
        place "spr00/png02.png" at 42, 142 repeat;
        place "spr00/png04.png" at 142, 76;
        place "spr00/png05.png" at 141, 129 add 35;
        place "spr00/png06.png" at 141, 130;
    }
    chase {
        background "spr00/png07.png" at 0, -39 sky 200;
    }
}
