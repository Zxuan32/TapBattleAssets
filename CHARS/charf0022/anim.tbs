animation {
    anos  = 41;
    padding = 3;

    ano_0 {
        priority = 131;
        frame { sprite = sprite_0; origin = -52, 0; }
    }

    ano_1 {
        priority = 131;
        frame { sprite = sprite_0; origin = -15, 0; }
    }

    ano_2 {
        priority = 131;
        frame { sprite = sprite_0; }
    }

    ano_3 {
        priority = 128;
        frame { time = 6; sprite = sprite_1; origin = -48, -48; }
        frame { time = 6; sprite = -1; origin = -48, -48; }
    }

    ano_4 {
        priority = 128;
        frame { time = 3; sprite = sprite_2; origin = -80, -64; }
        frame { time = 3; sprite = sprite_2; origin = -72, -72; }
        frame { time = 3; sprite = sprite_2; origin = -80, -64; }
        frame { time = 3; sprite = sprite_2; origin = -72, -72; }
        frame { time = 3; sprite = sprite_2; origin = -80, -64; }
        frame { time = 3; sprite = sprite_2; origin = -72, -72; }
        frame { time = 6; sprite = -1; origin = -80, -64; }
    }

    ano_5 {
        priority = 128;
        frame { time = 3; sprite = sprite_3; origin = -80, -64; }
        frame { time = 3; sprite = sprite_3; origin = -72, -72; }
        frame { time = 3; sprite = sprite_3; origin = -80, -64; }
        frame { time = 3; sprite = sprite_3; origin = -72, -72; }
        frame { time = 3; sprite = sprite_3; origin = -80, -64; }
        frame { time = 3; sprite = sprite_3; origin = -72, -72; }
        frame { time = 6; sprite = -1; origin = -80, -64; }
    }

    ano_6 {
        priority = 128;
        frame { time = 3; sprite = sprite_4; origin = -96, -144; }
        frame { time = 3; sprite = sprite_4; origin = -88, -152; }
        frame { time = 3; sprite = sprite_4; origin = -96, -144; }
        frame { time = 3; sprite = sprite_4; origin = -88, -152; }
        frame { time = 3; sprite = sprite_4; origin = -96, -144; }
        frame { time = 3; sprite = sprite_4; origin = -88, -152; }
        frame { time = 3; sprite = -1; origin = -136, -104; }
    }

    ano_7 {
        priority = 128;
        frame { time = 3; sprite = sprite_4; origin = -96, -144; }
        frame { time = 3; sprite = sprite_4; origin = -88, -152; }
        frame { time = 3; sprite = sprite_4; origin = -96, -144; }
        frame { time = 3; sprite = sprite_4; origin = -88, -152; }
        frame { time = 3; sprite = sprite_4; origin = -96, -144; }
        frame { time = 3; sprite = sprite_4; origin = -88, -152; }
        frame { time = 3; sprite = -1; origin = -136, -104; }
    }

    ano_10 {
        priority = 236;
        frame { sprite = -1; }
    }

    ano_11 {
        priority = 236;
        link ano_33 { flag = 12; }
        link ano_34 { flag = 12; }
        link ano_35 { flag = 12; }
        frame { time = 3; sprite = sprite_5; origin = -88, -160; }
        frame { time = 3; sprite = sprite_5; origin = -90, -164; loop; }
    }

    ano_12 {
        priority = 236;
        frame {
            time = 6; sprite = sprite_6; origin = -63, -117;
            options { tween; }
        }
        frame {
            time = 1; sprite = sprite_6; origin = -63, -117;
            render { rotate = 0; alpha = 255; zoom = 100, 100; }
        }
    }

    ano_13 {
        priority = 236;
        frame { time = 6; sprite = sprite_1; origin = -15, -125; }
        frame { time = 6; sprite = -1; origin = -31, -37; }
    }

    ano_14 {
        priority = 128;
        frame { time = 6; sprite = sprite_7; origin = -16, -32; }
        frame { time = 6; sprite = -1; origin = -16, -32; }
    }

    ano_33 {
        priority = 236;
        frame {
            time = 3; sprite = sprite_5; origin = -80, -128;
            render { rotate = 0; alpha = 0; zoom = 95, 95; }
        }
        frame {
            time = 3; sprite = sprite_5; origin = -82, -132; loop;
            render { rotate = 0; alpha = 0; zoom = 95, 95; }
        }
    }

    ano_34 {
        priority = 236;
        frame {
            time = 3; sprite = sprite_5; origin = -72, -96;
            render { rotate = 0; alpha = 0; zoom = 90, 90; }
        }
        frame {
            time = 3; sprite = sprite_5; origin = -74, -100; loop;
            render { rotate = 0; alpha = 0; zoom = 90, 90; }
        }
    }

    ano_35 {
        priority = 236;
        frame { time = 3; sprite = sprite_8; origin = -56, -56; }
        frame { time = 3; sprite = sprite_8; origin = -58, -60; loop; }
    }
}
